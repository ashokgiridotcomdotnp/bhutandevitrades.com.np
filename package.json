{
  "name": "bhutandevitrades.com.np",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./public/stylesheets/tailwind.css -o ./public/stylesheets/style.css --minify",
    "watch:css": "tailwindcss -i ./public/stylesheets/tailwind.css -o ./public/stylesheets/style.css --watch",
    "dev": "nodemon ./bin/www",
    "migrate:catalog:dry": "node ./scripts/migrate-catalog-admin-state.js --dry-run",
    "migrate:catalog": "node ./scripts/migrate-catalog-admin-state.js",
    "prestart": "npm run build:css",
    "start": "node ./bin/www"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "~1.4.4",
    "csurf": "^1.11.0",
    "debug": "~2.6.9",
    "dotenv": "^17.3.1",
    "ejs": "~2.6.1",
    "express": "~4.16.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "flowbite": "^4.0.1",
    "helmet": "^8.1.0",
    "http-errors": "~1.6.3",
    "mongoose": "^9.2.1",
    "morgan": "~1.9.1",
    "multer": "^2.0.2",
    "nodemon": "^3.1.11",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
