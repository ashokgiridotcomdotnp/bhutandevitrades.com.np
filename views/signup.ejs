<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="<%= assetPath('/stylesheets/style.css') %>" />
  </head>
  <body class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 text-slate-900">
    <div class="flex min-h-screen flex-col items-center justify-center px-4 py-12">
      <div class="relative w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-lg sm:p-8">
       <a
          href="/"
          aria-label="Back to home"
          title="Back to home"
          class="group absolute right-3 top-6 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-900 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
        >
          <img src="/images/logo.png" alt="BhutanDevi logo" class="h-full w-full rounded-full bg-white" />
          <span class="pointer-events-none absolute -top-8 right-0 hidden whitespace-nowrap rounded-md bg-slate-900 px-2 py-1 text-xs font-semibold text-white shadow-sm group-hover:block group-focus-visible:block">Back to home</span>
        </a>


        <h1 class="pr-12 text-2xl font-extrabold tracking-tight text-slate-900">Create account</h1>
        <p class="mt-1 text-sm text-slate-600"><%= requireCode ? 'Enter the verification code sent to your email' : 'Sign up to start ordering' %></p>

        <% if (statusMessage) { %>
        <div class="hidden" data-success-alert><%= statusMessage %></div>
        <% } %>

        <% if (errorMessage) { %>
        <div class="mt-4 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" data-signup-form-error role="alert">
          <%= errorMessage %>
        </div>
        <% } else { %>
        <div class="hidden mt-4 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" data-signup-form-error role="alert"></div>
        <% } %>

        <form action="/signup" method="post" class="mt-6 space-y-4">
          <% if (!requireCode) { %>
          <div>
            <label for="signup-name" class="mb-1.5 block text-sm font-semibold text-slate-800">Full Name</label>
            <input
              id="signup-name"
              name="name"
              type="text"
              value="<%= authName || '' %>"
              minlength="<%= minUserNameLength %>"
              maxlength="<%= maxUserNameLength %>"
              autocomplete="name"
              required
              class="pro-input"
              placeholder="Your full name"
            />
          </div>

          <div>
            <label for="signup-email" class="mb-1.5 block text-sm font-semibold text-slate-800">Email</label>
            <input
              id="signup-email"
              name="email"
              type="email"
              value="<%= authEmail || '' %>"
              maxlength="<%= maxEmailLength %>"
              autocomplete="email"
              required
              class="pro-input"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label for="signup-password" class="mb-1.5 block text-sm font-semibold text-slate-800">Password</label>
            <input
              id="signup-password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="<%= minPasswordLength %>"
              maxlength="<%= maxPasswordLength %>"
              required
              class="pro-input"
              placeholder="Min <%= minPasswordLength %> characters"
            />
          </div>
          <% } else { %>
          <input type="hidden" name="name" value="<%= authName || '' %>" />
          <input type="hidden" name="email" value="<%= authEmail || '' %>" />
          <p class="text-sm text-slate-600">We've sent a <%= verificationCodeLength %>-digit code to <strong><%= authEmail %></strong></p>
          <div>
            <label for="signup-verification-code" class="mb-1.5 block text-sm font-semibold text-slate-800">Verification Code</label>
            <input
              id="signup-verification-code"
              name="verificationCode"
              type="text"
              inputmode="numeric"
              pattern="[0-9]{<%= verificationCodeLength %>}"
              minlength="<%= verificationCodeLength %>"
              maxlength="<%= verificationCodeLength %>"
              autocomplete="one-time-code"
              required
              class="pro-input text-center text-2xl tracking-[0.5em]"
              placeholder="<%= '•'.repeat(verificationCodeLength) %>"
            />
          </div>
          <% } %>

          <button type="submit" class="pro-btn-primary w-full">
            <%= requireCode ? 'Verify & Create Account' : 'Create Account' %>
          </button>
        </form>

        <% if (requireCode) { %>
        <form action="/signup" method="post" class="mt-3 text-center">
          <input type="hidden" name="name" value="<%= authName || '' %>" />
          <input type="hidden" name="email" value="<%= authEmail || '' %>" />
          <button type="submit" class="text-sm font-semibold text-cyan-700 hover:text-cyan-800">Resend code</button>
        </form>
        <% } %>

        <div class="mt-6 text-center text-sm">
          <a href="/login" class="font-semibold text-cyan-700 hover:text-cyan-800">Already have an account? Sign in</a>
        </div>
      </div>

      <p class="mt-8 text-center text-xs text-slate-500">
        Secure signup powered by BhutanDevi Trade
      </p>
    </div>
    <%- include('helpers/footer', { basePath: '/', categoryGroups: [], storeWhatsappNumber: '', compactFooter: true }) %>
    <%- include('helpers/toaster') %>
    <script src="<%= assetPath('/javascripts/flash-alert.js') %>"></script>
    <script src="<%= assetPath('/javascripts/signup.js') %>"></script>
  </body>
</html>
