<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="text-slate-900">
    <%- include('helpers/nav', { title: 'BhutanDevi Trade and Suppliers', q, activeCategory, hasSidebar: true, topNavCategories, searchSuggestions, basePath, currentPath, currentUser, showUserAuthActions }) %>

    <main class="app-shell py-6">
      <div id="home-layout-grid" class="grid gap-5 lg:grid-cols-[20rem_minmax(0,1fr)]">
        <%- include('helpers/sidebar', { categoryGroups, hasQuery, q, activeCategory, openCategoryName, basePath, currentUser, showUserAuthActions, currentPath }) %>

        <section class="min-w-0 pro-page-enter">
          <section class="mx-auto w-full max-w-4xl pro-panel p-4 sm:p-6">
            <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_17rem]">
              <div class="pro-stagger">
                <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Sign Up</h1>
                <p class="mt-1 text-sm text-slate-600">Create your account with email and password, then verify your email using a one-time code.</p>

                <% if (statusMessage) { %>
                <div class="mt-4 flex items-start justify-between gap-3 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700" data-success-alert>
                  <span><%= statusMessage %></span>
                  <button
                    type="button"
                    class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-emerald-300 bg-white/80 text-emerald-700 hover:bg-white"
                    data-dismiss-alert
                    aria-label="Dismiss success message"
                  >
                    &times;
                  </button>
                </div>
                <% } %>

                <% if (errorMessage) { %>
                <div class="mt-4 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" data-error-alert><%= errorMessage %></div>
                <% } %>

                <form action="/signup" method="post" class="mt-5 space-y-4">
                  <div>
                    <label for="signup-name" class="mb-1.5 block text-sm font-semibold text-slate-800">Full Name</label>
                    <input
                      id="signup-name"
                      name="name"
                      type="text"
                      value="<%= authName || '' %>"
                      required
                      class="pro-input"
                      placeholder="Your full name"
                    />
                  </div>

                  <div>
                    <label for="signup-email" class="mb-1.5 block text-sm font-semibold text-slate-800">Email Address</label>
                    <input
                      id="signup-email"
                      name="email"
                      type="email"
                      value="<%= authEmail || '' %>"
                      required
                      class="pro-input"
                      placeholder="you@gmail.com"
                    />
                  </div>

                  <div>
                    <label for="signup-password" class="mb-1.5 block text-sm font-semibold text-slate-800">Password</label>
                    <input
                      id="signup-password"
                      name="password"
                      type="password"
                      autocomplete="new-password"
                      <%= requireCode ? '' : 'required' %>
                      class="pro-input"
                      placeholder="Minimum 6 characters"
                    />
                  </div>

                  <% if (requireCode) { %>
                  <p class="rounded-lg border border-cyan-200 bg-cyan-50 px-3 py-2 text-xs font-semibold text-cyan-800">Enter the verification code sent to your email to activate your account.</p>
                  <div>
                    <label for="signup-verification-code" class="mb-1.5 block text-sm font-semibold text-slate-800">Verification Code</label>
                    <input
                      id="signup-verification-code"
                      name="verificationCode"
                      type="text"
                      inputmode="numeric"
                      pattern="[0-9]{6}"
                      maxlength="6"
                      required
                      class="pro-input"
                      placeholder="Enter 6-digit code"
                    />
                  </div>
                  <% } %>

                  <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
                    <a href="/login" class="text-sm font-semibold text-cyan-700 hover:text-cyan-800">Already have an account?</a>
                    <button type="submit" class="pro-btn-primary"><%= requireCode ? 'Verify Email and Sign Up' : 'Create Account and Send Code' %></button>
                  </div>
                </form>
              </div>

              <aside class="hidden rounded-xl border border-slate-200 bg-slate-50 p-4 lg:block">
                <h2 class="text-xs font-extrabold uppercase tracking-[0.14em] text-slate-500">Signup Guide</h2>
                <ul class="mt-3 space-y-2 text-sm font-medium text-slate-700">
                  <li>1. Add your full name and email.</li>
                  <li>2. Create a strong password.</li>
                  <li>3. Verify your email with one-time code.</li>
                </ul>
                <div class="mt-4 rounded-lg border border-slate-200 bg-white p-3 text-xs font-semibold text-slate-600">
                  Use an active email so you can receive verification and order updates.
                </div>
              </aside>
            </div>
          </section>
        </section>
      </div>
    </main>
    <%- include('helpers/footer', { basePath, currentPath, categoryGroups, currentUser }) %>
    <script src="/javascripts/flash-alert.js"></script>
  </body>
</html>
