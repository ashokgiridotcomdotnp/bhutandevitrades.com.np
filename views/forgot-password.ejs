<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 text-slate-900">
    <div class="flex min-h-screen flex-col items-center justify-center px-4 py-12">
      <a href="/" class="mb-8 inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-white shadow-sm">
        <img src="/icons/logo.svg" alt="" class="h-8 w-8 rounded-full bg-white p-1" />
        <span class="text-sm font-bold tracking-wide">BhutanDevi Trade</span>
      </a>

      <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-lg sm:p-8">
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Reset password</h1>
        <p class="mt-1 text-sm text-slate-600"><%= requireCode ? 'Enter the code and your new password' : 'We\'ll send a reset code to your email' %></p>

        <% if (statusMessage) { %>
        <div class="mt-4 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">
          <%= statusMessage %>
        </div>
        <% } %>

        <% if (errorMessage) { %>
        <div class="mt-4 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
          <%= errorMessage %>
        </div>
        <% } %>

        <form action="/forgot-password" method="post" class="mt-6 space-y-4">
          <div>
            <label for="forgot-email" class="mb-1.5 block text-sm font-semibold text-slate-800">Email</label>
            <input
              id="forgot-email"
              name="email"
              type="email"
              value="<%= authEmail || '' %>"
              maxlength="<%= maxEmailLength %>"
              autocomplete="email"
              required
              class="pro-input"
              placeholder="you@example.com"
            />
          </div>

          <% if (requireCode) { %>
          <div>
            <label for="forgot-new-password" class="mb-1.5 block text-sm font-semibold text-slate-800">New Password</label>
            <input
              id="forgot-new-password"
              name="password"
              type="password"
              autocomplete="new-password"
              minlength="<%= minPasswordLength %>"
              maxlength="<%= maxPasswordLength %>"
              required
              class="pro-input"
              placeholder="Min <%= minPasswordLength %> characters"
            />
          </div>

          <div>
            <label for="forgot-verification-code" class="mb-1.5 block text-sm font-semibold text-slate-800">Verification Code</label>
            <input
              id="forgot-verification-code"
              name="verificationCode"
              type="text"
              inputmode="numeric"
              pattern="[0-9]{<%= verificationCodeLength %>}"
              minlength="<%= verificationCodeLength %>"
              maxlength="<%= verificationCodeLength %>"
              autocomplete="one-time-code"
              required
              class="pro-input text-center text-2xl tracking-[0.5em]"
              placeholder="<%= '•'.repeat(verificationCodeLength) %>"
            />
          </div>
          <% } %>

          <button type="submit" class="pro-btn-primary w-full">
            <%= requireCode ? 'Reset Password' : 'Send Reset Code' %>
          </button>
        </form>

        <div class="mt-6 text-center text-sm">
          <a href="/login" class="font-semibold text-cyan-700 hover:text-cyan-800">Back to login</a>
        </div>
      </div>

      <p class="mt-8 text-center text-xs text-slate-500">
        Secure password reset powered by BhutanDevi Trade
      </p>
    </div>
  </body>
</html>
