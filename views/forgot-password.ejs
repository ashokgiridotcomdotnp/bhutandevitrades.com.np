<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="text-slate-900">
    <%- include('helpers/nav', { title: 'BhutanDevi Trade and Suppliers', q, activeCategory, hasSidebar: true, topNavCategories, searchSuggestions, basePath, currentPath, currentUser, showUserAuthActions }) %>

    <main class="app-shell py-6">
      <div id="home-layout-grid" class="grid gap-5 lg:grid-cols-[20rem_minmax(0,1fr)]">
        <%- include('helpers/sidebar', { categoryGroups, hasQuery, q, activeCategory, openCategoryName, basePath, currentUser, showUserAuthActions, currentPath }) %>

        <section class="min-w-0 pro-page-enter">
          <section class="mx-auto w-full max-w-xl pro-panel p-5 sm:p-6 pro-stagger">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Forgot Password</h1>
            <p class="mt-1 text-sm text-slate-600">Reset your password with a one-time verification code sent to your email.</p>

        <% if (statusMessage) { %>
        <div class="mt-4 flex items-start justify-between gap-3 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700" data-success-alert>
          <span><%= statusMessage %></span>
          <button
            type="button"
            class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-emerald-300 bg-white/80 text-emerald-700 hover:bg-white"
            data-dismiss-alert
            aria-label="Dismiss success message"
          >
            &times;
          </button>
        </div>
        <% } %>

        <% if (errorMessage) { %>
        <div class="mt-4 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" data-error-alert><%= errorMessage %></div>
        <% } %>

            <form action="/forgot-password" method="post" class="mt-5 space-y-3">
          <div>
            <label for="forgot-email" class="mb-1.5 block text-sm font-semibold text-slate-800">Email Address</label>
            <input
              id="forgot-email"
              name="email"
              type="email"
              value="<%= authEmail || '' %>"
              required
              class="pro-input"
              placeholder="you@gmail.com"
            />
          </div>

          <% if (requireCode) { %>
          <p class="text-xs font-semibold text-slate-500">Enter the 6-digit code and set your new password.</p>
          <div>
            <label for="forgot-new-password" class="mb-1.5 block text-sm font-semibold text-slate-800">New Password</label>
            <input
              id="forgot-new-password"
              name="password"
              type="password"
              autocomplete="new-password"
              required
              class="pro-input"
              placeholder="Minimum 6 characters"
            />
          </div>

          <div>
            <label for="forgot-verification-code" class="mb-1.5 block text-sm font-semibold text-slate-800">Verification Code</label>
            <input
              id="forgot-verification-code"
              name="verificationCode"
              type="text"
              inputmode="numeric"
              pattern="[0-9]{6}"
              maxlength="6"
              required
              class="pro-input"
              placeholder="Enter 6-digit code"
            />
          </div>
          <% } %>

          <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
            <a href="/login" class="text-sm font-semibold text-cyan-700 hover:text-cyan-800">Back to login</a>
            <button type="submit" class="pro-btn-primary"><%= requireCode ? 'Reset Password' : 'Send Reset Code' %></button>
          </div>
            </form>
          </section>
        </section>
      </div>
    </main>
    <%- include('helpers/footer', { basePath, currentPath, categoryGroups, currentUser }) %>
    <script src="/javascripts/flash-alert.js"></script>
  </body>
</html>
