<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="text-slate-900">
    <%- include('helpers/nav', { title: 'BhutanDevi Trade and Suppliers', q, activeCategory, hasSidebar: true, topNavCategories, searchSuggestions, basePath, currentPath, currentUser, showUserAuthActions }) %>

    <main class="app-shell py-6">
      <div id="home-layout-grid" class="grid gap-5 lg:grid-cols-[20rem_minmax(0,1fr)]">
        <%- include('helpers/sidebar', { categoryGroups, hasQuery, q, activeCategory, openCategoryName, basePath, currentUser, showUserAuthActions, currentPath }) %>

        <section class="min-w-0 pro-page-enter">
          <section class="mx-auto w-full max-w-4xl pro-panel p-5 sm:p-6 pro-stagger">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Profile Settings</h1>
                <p class="mt-1 text-sm text-slate-600">Update your account name and password.</p>
              </div>
              <a href="/home" class="pro-btn-secondary">Browse Products</a>
            </div>

            <% if (statusMessage) { %>
            <div class="mt-4 flex items-start justify-between gap-3 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700" data-success-alert>
              <span><%= statusMessage %></span>
              <button
                type="button"
                class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-emerald-300 bg-white/80 text-emerald-700 hover:bg-white"
                data-dismiss-alert
                aria-label="Dismiss success message"
              >
                &times;
              </button>
            </div>
            <% } %>

            <% if (errorMessage) { %>
            <div class="mt-4 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" data-error-alert><%= errorMessage %></div>
            <% } %>

            <div class="mt-5 grid gap-4 lg:grid-cols-2">
              <section class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                <h2 class="text-lg font-extrabold text-slate-900">Update Name</h2>
                <p class="mt-1 text-sm text-slate-600">Keep your profile name current for order communication.</p>

                <form action="/profile/name" method="post" class="mt-4 space-y-3">
                  <div>
                    <label for="profile-email" class="mb-1.5 block text-sm font-semibold text-slate-800">Email Address</label>
                    <input id="profile-email" type="email" class="pro-input" value="<%= profileEmail || '' %>" readonly />
                  </div>

                  <div>
                    <label for="profile-name" class="mb-1.5 block text-sm font-semibold text-slate-800">Full Name</label>
                    <input
                      id="profile-name"
                      name="name"
                      type="text"
                      minlength="<%= minUserNameLength %>"
                      maxlength="<%= maxUserNameLength %>"
                      autocomplete="name"
                      required
                      class="pro-input"
                      value="<%= profileName || '' %>"
                      placeholder="Enter your full name"
                    />
                  </div>

                  <div class="pt-1">
                    <button type="submit" class="pro-btn-primary w-full sm:w-auto">Update Name</button>
                  </div>
                </form>
              </section>

              <section class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                <h2 class="text-lg font-extrabold text-slate-900">Change Password</h2>
                <p class="mt-1 text-sm text-slate-600">Use a strong password between <%= minPasswordLength %> and <%= maxPasswordLength %> characters.</p>

                <form action="/profile/password" method="post" class="mt-4 space-y-3">
                  <div>
                    <label for="profile-current-password" class="mb-1.5 block text-sm font-semibold text-slate-800">Current Password</label>
                    <input
                      id="profile-current-password"
                      name="currentPassword"
                      type="password"
                      autocomplete="current-password"
                      maxlength="<%= maxPasswordLength %>"
                      required
                      class="pro-input"
                      placeholder="Enter current password"
                    />
                  </div>

                  <div>
                    <label for="profile-new-password" class="mb-1.5 block text-sm font-semibold text-slate-800">New Password</label>
                    <input
                      id="profile-new-password"
                      name="newPassword"
                      type="password"
                      autocomplete="new-password"
                      required
                      minlength="<%= minPasswordLength %>"
                      maxlength="<%= maxPasswordLength %>"
                      class="pro-input"
                      placeholder="Enter new password"
                    />
                  </div>

                  <div>
                    <label for="profile-confirm-password" class="mb-1.5 block text-sm font-semibold text-slate-800">Confirm New Password</label>
                    <input
                      id="profile-confirm-password"
                      name="confirmPassword"
                      type="password"
                      autocomplete="new-password"
                      required
                      minlength="<%= minPasswordLength %>"
                      maxlength="<%= maxPasswordLength %>"
                      class="pro-input"
                      placeholder="Re-enter new password"
                    />
                  </div>

                  <div class="pt-0.5">
                    <a href="/forgot-password" class="text-sm font-semibold text-cyan-700 hover:text-cyan-800">Forgot current password?</a>
                  </div>

                  <div class="pt-1">
                    <button type="submit" class="pro-btn-primary w-full sm:w-auto">Update Password</button>
                  </div>
                </form>
              </section>
            </div>
          </section>
        </section>
      </div>
    </main>
    <%- include('helpers/footer', { basePath, currentPath, categoryGroups, currentUser }) %>
    <script src="/javascripts/flash-alert.js"></script>
  </body>
</html>
