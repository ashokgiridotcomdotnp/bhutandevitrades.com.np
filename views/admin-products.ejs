<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="<%= assetPath('/stylesheets/style.css') %>" />
  </head>
  <body class="text-slate-900">
    <main class="app-shell py-6 pro-page-enter">
      <%
        function toAnchor(value) {
          return String(value || '')
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }

        function toCount(value) {
          var parsed = Number(value);
          return Number.isFinite(parsed) ? parsed : 0;
        }

        function toInputNumberValue(value) {
          if (value === null || typeof value === 'undefined' || value === '') return '';
          // coerce to string and strip common formatting/currency characters
          var s = String(value).trim();
          // Remove currency symbols and grouping commas, keep digits, dot and minus
          s = s.replace(/[^0-9.\-]/g, '');
          if (!s) return '';
          var n = Number(s);
          if (!Number.isFinite(n)) return '';
          // integers: return without decimal; otherwise keep up to 2 decimals
          if (Math.floor(n) === n) return String(n);
          return String(Number(n.toFixed(2)));
        }

        function buildAdminProductsPageHref(targetPage) {
          var parsedPage = Number(targetPage);
          var safePage = Number.isFinite(parsedPage) && parsedPage > 0 ? Math.floor(parsedPage) : 1;

          if (safePage <= 1) {
            return '/admin/products';
          }

          return '/admin/products?page=' + safePage;
        }

        var stats = dashboardStats && typeof dashboardStats === 'object' ? dashboardStats : {};
        var rows = Array.isArray(productRows) ? productRows : [];
        var currentPage = Number.isFinite(Number(adminProductsPage)) ? Math.max(1, Number(adminProductsPage)) : 1;
        var totalPages = Number.isFinite(Number(adminProductsTotalPages)) ? Math.max(1, Number(adminProductsTotalPages)) : 1;
        var currentPagePath = String(adminProductsPagePath || buildAdminProductsPageHref(currentPage));
      %>

      <header class="mb-4 pro-panel px-5 py-4 pro-stagger">
        <div class="flex flex-wrap items-start gap-3">
          <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Products</h1>
            <p class="mt-0.5 text-sm text-slate-600">Browse the full product overview outside the dashboard forms.</p>
          </div>

          <div class="ml-auto flex flex-wrap items-center gap-2">
            <a href="/admin" class="pro-btn-secondary pro-btn-sm">Dashboard</a>
            <a href="/admin/orders" class="pro-btn-secondary pro-btn-sm">Order Requests</a>
            <a href="/admin/profile" class="pro-btn-primary pro-btn-sm">Profile</a>
            <a href="/admin/logout" class="pro-btn-secondary pro-btn-sm gap-1.5">
              <span>Logout</span>
            </a>
          </div>
        </div>
      </header>

      <% if (statusMessage) { %>
      <div class="hidden" data-success-alert><%= statusMessage %></div>
      <% } %>

      <% if (errorMessage) { %>
      <div class="hidden" data-error-alert><%= errorMessage %></div>
      <% } %>

      <section class="mb-4 grid gap-3 sm:grid-cols-3">
        <article class="pro-panel p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Products</p>
          <p class="pt-2 text-3xl font-extrabold text-slate-900" data-product-overview-count><%= toCount(totalProductCount) %> products</p>
          <p class="pt-1 text-xs text-slate-500"><%= toCount(stats.adminOnlyProducts) %> admin-added</p>
        </article>
        <article class="pro-panel p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Categories</p>
          <p class="pt-2 text-3xl font-extrabold text-slate-900"><%= toCount(stats.totalCategories) %></p>
          <p class="pt-1 text-xs text-slate-500">Visible product groups</p>
        </article>
        <article class="pro-panel p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Avg Products</p>
          <p class="pt-2 text-3xl font-extrabold text-slate-900"><%= toCount(stats.averageProductsPerCategory) %></p>
          <p class="pt-1 text-xs text-slate-500">Per category</p>
        </article>
      </section>

      <section class="pro-panel min-w-0 self-start px-4 pb-4 pt-5 sm:px-4 sm:pb-4 sm:pt-5" data-managed-products-root>
          <div class="flex flex-wrap items-start gap-1.5 border-b border-slate-200 pb-3">
            <div class="min-w-0 flex-1 grid gap-0.5">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Inventory</p>
              <h2 class="text-lg font-extrabold tracking-tight text-slate-900">Products</h2>
              <p class="text-xs text-slate-600">Edit price, stock, title, image, and category assignments directly from this table.</p>
            </div>

            <span class="rounded-full border border-slate-300 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-600" data-managed-product-count-badge><%= toCount(rows.length) %> products</span>
          </div>

          <% if (!rows.length) { %>
          <div class="pt-4 text-sm text-slate-500" data-managed-products-empty>No products yet. Add products from the dashboard.</div>
          <% } else { %>
          <div class="hidden pt-4 text-sm text-slate-500" data-managed-products-empty>No products left.</div>
          <div class="pt-3" data-managed-products-table>
            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div class="h-fit">
                <table class="w-full min-w-[72rem] border-collapse text-sm">
                  <thead class="sticky top-0 z-10 bg-slate-50/95 backdrop-blur">
                    <tr class="text-left text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-600">
                      <th class="px-3 py-3">Product</th>
                      <th class="px-3 py-3">Category</th>
                      <th class="px-3 py-3">Description</th>
                      <th class="px-3 py-3">Price</th>
                      <th class="px-3 py-3">Stock</th>
                      <th class="px-3 py-3">Sold</th>
                      <th class="px-3 py-3">Image</th>
                      <th class="px-3 py-3 text-right">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-200" data-managed-products-table-body>
                    <!-- Skeleton rows shown during global loading -->
                    <tr data-skeleton-target class="hidden">
                      <td class="px-3 py-3">
                        <div class="grid gap-1">
                          <div class="h-4 w-48 rounded bg-slate-200 animate-pulse"></div>
                          <div class="h-3 w-28 rounded bg-slate-200 animate-pulse"></div>
                        </div>
                      </td>
                      <td class="px-3 py-3"><div class="h-4 w-24 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-4 w-48 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-4 w-24 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-4 w-12 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-10 w-24 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-8 w-24 rounded bg-slate-200 animate-pulse"></div></td>
                    </tr>
                    <tr data-skeleton-target class="hidden">
                      <td class="px-3 py-3"><div class="h-4 w-48 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-4 w-24 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-4 w-48 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-4 w-24 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-4 w-12 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-10 w-24 rounded bg-slate-200 animate-pulse"></div></td>
                      <td class="px-3 py-3"><div class="h-8 w-24 rounded bg-slate-200 animate-pulse"></div></td>
                    </tr>
                    <% rows.forEach(function (item) { %>
                    <% var editImageInputId = 'edit-image-' + item.id; %>
                    <% var hasItemDiscount = item.originalPrice && item.originalPrice !== item.price; %>
                    <% var editMrpInputValue = toInputNumberValue(item.originalPrice || item.price); %>
                    <% var editDiscountInputValue = toInputNumberValue(item.discountPercent); %>
                    <% var editQuantityInputValue = toInputNumberValue(item.quantity); %>
                    <% var stockValue = item.quantity || item.quantity === 0 ? item.quantity : '-'; %>
                    <tr class="align-middle transition-colors hover:bg-slate-50/70" data-view-panel="<%= item.id %>">
                      <td class="px-3 py-3" data-product-name-cell>
                        <div class="grid gap-1">
                          <p class="text-sm font-bold leading-5 text-slate-900" data-product-name-text><%= item.name %></p>
                          <p class="font-mono text-[11px] text-slate-500">ID: <span data-product-id-text><%= item.id %></span></p>
                        </div>
                      </td>
                      <td class="px-3 py-3">
                        <span class="inline-flex rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-700" data-product-category-text><%= item.categoryName || item.type || 'Other' %></span>
                      </td>
                      <td class="px-3 py-3">
                        <p class="max-w-[20rem] text-sm leading-5 text-slate-700" data-product-spec-text><%= item.spec || 'No description' %></p>
                      </td>
                      <td class="px-3 py-3 text-slate-800" data-product-price-cell>
                        <% if (hasItemDiscount) { %>
                        <p class="text-xs font-semibold text-red-600 line-through" data-product-original-price-text><%= item.originalPrice %></p>
                        <% } else { %>
                        <p class="hidden text-xs font-semibold text-red-600 line-through" data-product-original-price-text></p>
                        <% } %>
                        <p class="pt-0.5 font-semibold text-emerald-700" data-product-final-price-text><%= item.price %></p>
                        <% if (item.discountPercent) { %>
                        <p class="pt-1 text-xs font-semibold text-slate-600" data-product-discount-text>Discount: <%= item.discountPercent %>%</p>
                        <% } else { %>
                        <p class="hidden pt-1 text-xs font-semibold text-slate-600" data-product-discount-text></p>
                        <% } %>
                      </td>
                      <td class="px-3 py-3">
                        <span class="inline-flex min-w-[3.25rem] justify-center rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-800" data-product-stock-text><%= stockValue %></span>
                      </td>
                      <td class="px-3 py-3">
                        <span class="inline-flex min-w-[4.5rem] items-center justify-center rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-800" data-product-sold-text><%= Number.isFinite(Number(item.sold)) ? (item.sold + ' sold') : '0 sold' %></span>
                      </td>
                      <td class="px-3 py-3">
                        <img
                          src="<%= item.image %>"
                          alt="<%= item.name %>"
                          class="h-16 w-24 rounded-lg border border-slate-200 bg-white object-contain"
                          loading="lazy"
                          data-product-image
                        />
                      </td>
                      <td class="px-3 py-3">
                        <div class="flex min-w-[9rem] items-center gap-1.5 sm:justify-end">
                          <button
                            type="button"
                            title="Edit item"
                            data-edit-toggle="<%= item.id %>"
                            class="pro-btn-secondary pro-btn-xs pro-btn-action"
                          >
                            Edit
                          </button>
                          <button
                            type="button"
                            title="Delete item"
                            data-delete-product-trigger="<%= item.id %>"
                            data-product-name="<%= item.name %>"
                            class="pro-btn-danger-muted pro-btn-xs pro-btn-action"
                          >
                            Delete
                          </button>
                        </div>
                      </td>
                    </tr>
                    <tr class="hidden bg-cyan-50/30 ring-1 ring-cyan-100" data-edit-row="<%= item.id %>">
                      <td colspan="8" class="px-0 py-3">
                        <form
                          action="/admin/products/edit"
                          method="post"
                          enctype="multipart/form-data"
                          class="grid gap-4 w-full rounded-none border-t border-slate-200 bg-cyan-50 p-4 xl:grid-cols-[minmax(0,1fr)_18rem]"
                          data-edit-form="<%= item.id %>"
                        >
                          <input type="hidden" name="productId" value="<%= item.id %>" />
                          <input type="hidden" name="currentImagePath" value="<%= item.image || '' %>" />
                          <input type="hidden" name="redirectTo" value="<%= currentPagePath %>" />

                          <div class="grid gap-4 sm:grid-cols-2">
                            <div class="grid gap-1.5">
                              <label class="text-xs font-semibold uppercase tracking-wide text-slate-600">Category</label>
                              <input
                                type="text"
                                name="productCategory"
                                value="<%= item.categoryName || item.type || '' %>"
                                required
                                class="pro-input"
                              />
                            </div>

                            <div class="grid gap-1.5">
                              <label class="text-xs font-semibold uppercase tracking-wide text-slate-600">Title</label>
                              <input
                                type="text"
                                name="productName"
                                value="<%= item.name %>"
                                required
                                class="pro-input"
                              />
                            </div>

                            <div class="grid gap-1.5 sm:col-span-2">
                              <label class="text-xs font-semibold uppercase tracking-wide text-slate-600">Description</label>
                              <input
                                type="text"
                                name="productSpec"
                                value="<%= item.spec %>"
                                placeholder="Description (optional)"
                                class="pro-input"
                              />
                            </div>

                            <div class="grid gap-1.5">
                              <label class="text-xs font-semibold uppercase tracking-wide text-slate-600">MRP</label>
                              <input
                                type="number"
                                name="productPrice"
                                value="<%= editMrpInputValue %>"
                                min="0"
                                step="0.01"
                                data-form-mrp-input
                                required
                                class="pro-input"
                              />
                            </div>

                            <div class="grid gap-1.5">
                              <label class="text-xs font-semibold uppercase tracking-wide text-slate-600">Discount (%)</label>
                              <input
                                type="number"
                                name="productDiscountPercent"
                                value="<%= editDiscountInputValue || '0' %>"
                                min="0"
                                max="100"
                                step="0.01"
                                data-form-discount-input
                                class="pro-input"
                              />
                            </div>

                            <div class="grid gap-1.5">
                              <label class="text-xs font-semibold uppercase tracking-wide text-slate-600">Quantity</label>
                              <input
                                type="number"
                                name="productQuantity"
                                value="<%= editQuantityInputValue %>"
                                min="0"
                                step="1"
                                class="pro-input"
                              />
                            </div>

                            <div class="hidden rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2" data-form-price-preview>
                              <p class="text-[11px] font-semibold uppercase tracking-wide text-emerald-700">Price Preview</p>
                              <div class="pt-1 flex items-end gap-2">
                                <span class="hidden text-xs font-semibold text-red-600 line-through" data-form-price-original></span>
                                <span class="text-sm font-extrabold text-emerald-700" data-form-price-final></span>
                              </div>
                            </div>

                            <div class="sm:col-span-2 flex flex-wrap items-center gap-2 pt-1">
                              <button type="submit" class="pro-btn-primary pro-btn-xs">Save Product</button>
                              <button
                                type="button"
                                data-edit-cancel="<%= item.id %>"
                                class="pro-btn-secondary pro-btn-xs"
                              >
                                Cancel
                              </button>
                            </div>
                          </div>

                          <div class="grid gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Photo</p>

                            <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
                              <img
                                src="<%= item.image %>"
                                alt="<%= item.name %>"
                                class="aspect-[4/3] h-full w-full object-contain"
                                data-image-preview-for="<%= editImageInputId %>"
                                data-image-preview-default-src="<%= item.image %>"
                              />
                            </div>

                            <div class="grid gap-2">
                              <label class="text-xs text-center font-semibold uppercase tracking-wide text-slate-600">Upload new photo</label>
                              <input
                                id="<%= editImageInputId %>"
                                type="file"
                                name="productImageFile"
                                accept="image/*"
                                data-file-input
                                class="sr-only"
                              />
                              <div class="flex flex-wrap text-center items-center gap-2">
                                <label
                                  for="<%= editImageInputId %>"
                                  class="inline-flex justify-center items-center rounded-lg border border-slate-300 bg-slate-100 px-3 cursor-pointer text-xs w-full py-2 font-semibold text-slate-700 transition hover:bg-slate-200"
                                >
                                  Choose Product Photo
                                </label>
                              </div>
                            </div>
                          </div>
                        </form>

                        <form action="/admin/products/delete" method="post" class="hidden" data-delete-product-form="<%= item.id %>">
                          <input type="hidden" name="productId" value="<%= item.id %>" />
                          <input type="hidden" name="redirectTo" value="<%= currentPagePath %>" />
                        </form>
                      </td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <% } %>

          <% if (totalPages > 1) { %>
          <div class="pt-4" data-managed-products-pagination>
            <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-200 pt-3">
              <a
                href="<%= buildAdminProductsPageHref(currentPage - 1) %>"
                class="pro-btn-secondary pro-btn-xs <%= currentPage <= 1 ? 'pointer-events-none opacity-50' : '' %>"
                aria-disabled="<%= currentPage <= 1 ? 'true' : 'false' %>"
              >
                Prev
              </a>

              <div class="flex flex-wrap items-center justify-center gap-1.5">
                <% for (var pageNumber = 1; pageNumber <= totalPages; pageNumber += 1) { %>
                <% if (pageNumber === 1 || pageNumber === totalPages || Math.abs(pageNumber - currentPage) <= 1) { %>
                <a
                  href="<%= buildAdminProductsPageHref(pageNumber) %>"
                  class="inline-flex min-w-[2.15rem] items-center justify-center rounded-lg border px-2.5 py-1.5 text-xs font-semibold transition <%= pageNumber === currentPage ? 'border-cyan-600 bg-cyan-600 text-white' : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-100' %>"
                >
                  <%= pageNumber %>
                </a>
                <% } else if ((pageNumber === 2 && currentPage > 4) || (pageNumber === totalPages - 1 && currentPage < totalPages - 3)) { %>
                <span class="px-1 text-xs font-semibold text-slate-500">...</span>
                <% } %>
                <% } %>
              </div>

              <a
                href="<%= buildAdminProductsPageHref(currentPage + 1) %>"
                class="pro-btn-secondary pro-btn-xs <%= currentPage >= totalPages ? 'pointer-events-none opacity-50' : '' %>"
                aria-disabled="<%= currentPage >= totalPages ? 'true' : 'false' %>"
              >
                Next
              </a>
            </div>
          </div>
          <% } %>
        </section>
    </main>

    <div id="delete-alert" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4">
      <div class="pro-panel w-full max-w-md p-5">
        <h3 class="text-lg font-bold text-slate-900" id="delete-alert-title">Delete</h3>
        <p class="pt-2 text-sm text-slate-700" id="delete-alert-message">Are you sure you want to delete this product?</p>
        <div class="pt-4 flex items-center justify-end gap-2">
          <button
            type="button"
            id="delete-alert-cancel"
            class="pro-btn-secondary"
          >
            Cancel
          </button>
          <button
            type="button"
            id="delete-alert-confirm"
            class="pro-btn-danger"
          >
            Delete
          </button>
        </div>
      </div>
    </div>

    <%- include('helpers/loading') %>
    <%- include('helpers/toaster') %>
    <script src="<%= assetPath('/javascripts/loading.js') %>"></script>
    <script src="<%= assetPath('/javascripts/flash-alert.js') %>"></script>
    <script src="<%= assetPath('/javascripts/admin.js') %>"></script>
    <script>
      (function () {
        function toggleEdit(id, show) {
          if (!id) return;
          var editRow = document.querySelector('[data-edit-row="' + id + '"]');
          if (!editRow) return;

          // hide other edit rows
          document.querySelectorAll('[data-edit-row]').forEach(function (r) {
            if (r !== editRow) {
              r.classList.add('hidden');
              var f = r.querySelector('form[data-edit-form]'); if (f) f.classList.add('hidden');
            }
          });

          var form = editRow.querySelector('form[data-edit-form]');
          if (show) {
            editRow.classList.remove('hidden');
            if (form) form.classList.remove('hidden');
            setTimeout(function () { editRow.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 60);
          } else {
            editRow.classList.add('hidden');
            if (form) form.classList.add('hidden');
          }
        }

        document.querySelectorAll('[data-edit-toggle]').forEach(function (btn) {
          btn.addEventListener('click', function () { toggleEdit(btn.getAttribute('data-edit-toggle'), true); });
        });

        document.querySelectorAll('[data-edit-cancel]').forEach(function (btn) {
          btn.addEventListener('click', function () { toggleEdit(btn.getAttribute('data-edit-cancel'), false); });
        });
      })();
    </script>
  </body>
</html>
