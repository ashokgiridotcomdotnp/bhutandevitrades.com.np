<%
  var currentBasePath = basePath === '/home' ? '/home' : '/';
  var shouldShowUserAuthActions = typeof showUserAuthActions !== 'undefined' ? Boolean(showUserAuthActions) : true;
  var authenticatedUser = currentUser && currentUser.email ? currentUser : null;
  var currentPathname = typeof currentPath === 'string' ? currentPath : '';
  var isLoginPath = currentPathname === '/login';
  var isSignupPath = currentPathname === '/signup';

  function buildCategoryHref(categoryName) {
    var params = [];
    if (categoryName) {
      params.push('category=' + encodeURIComponent(categoryName));
    }
    return currentBasePath + (params.length ? '?' + params.join('&') : '');
  }

  function buildSubcategoryHref(categoryName, subCategoryName) {
    var params = [];
    if (categoryName) {
      params.push('category=' + encodeURIComponent(categoryName));
    }
    if (subCategoryName) {
      params.push('q=' + encodeURIComponent(subCategoryName));
    }
    return currentBasePath + (params.length ? '?' + params.join('&') : '');
  }
%>

<aside
  id="mobile-category-sidebar"
  class="fixed inset-x-0 bottom-0 top-0 z-[70] w-full max-w-none -translate-x-full overflow-hidden bg-slate-100 px-2 pb-3 pt-3 opacity-0 pointer-events-none transition-all duration-300 ease-out will-change-transform lg:sticky lg:top-[6.8rem] lg:z-auto lg:self-start lg:w-auto lg:max-w-none lg:translate-x-0 lg:overflow-visible lg:bg-transparent lg:px-0 lg:pb-0 lg:pt-0 lg:opacity-100 lg:pointer-events-auto"
>
  <div class="pro-panel h-full overflow-y-auto p-3 lg:mr-2 lg:h-auto lg:max-h-[calc(100vh-7.3rem)] lg:overflow-y-auto">
    <div class="mb-3 flex items-center justify-between gap-2 lg:hidden">
      <a href="<%= currentBasePath %>" class="flex min-w-0 flex-1 items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-2.5 py-2 transition hover:border-slate-300 hover:bg-white">
        <img src="/icons/logo.svg" alt="BhutanDevi avatar" class="h-10 w-10 shrink-0 rounded-full border border-slate-300 bg-white p-1" />
        <span class="min-w-0">
          <span class="block truncate text-sm font-bold text-slate-900">BhutanDevi Trade</span>
          <span class="block truncate text-xs text-slate-500">Parts and accessories</span>
        </span>
      </a>
      <button
        id="mobile-sidebar-close"
        type="button"
        aria-label="Close categories panel"
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-700 transition hover:border-slate-400 hover:bg-slate-100"
      >
        <img src="/icons/close.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 18px; height: 18px;" />
      </button>
    </div>

    <a href="<%= currentBasePath %>" class="hidden items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 transition hover:border-slate-300 hover:bg-white lg:flex">
      <img src="/icons/logo.svg" alt="BhutanDevi avatar" class="h-10 w-10 rounded-full border border-slate-300 bg-white p-1" />
      <div>
        <span class="block truncate text-sm font-bold text-slate-900">BhutanDevi Trade</span>
        <span class="block text-xs text-slate-500">Parts and accessories</span>
      </div>
    </a>

    <div class="mt-4 space-y-1.5">
      <% categoryGroups.forEach(function(group) { %>
      <details
        data-category-accordion-item
        data-category-name="<%= group.name %>"
        data-category-href="<%= buildCategoryHref(group.name) %>"
        class="group rounded-xl border border-slate-200 bg-white/90 p-1 transition-all duration-200 hover:shadow-sm"
        <%= openCategoryName === group.name || group.isActive ? 'open' : '' %>
      >
        <summary
          class="flex cursor-pointer list-none items-center gap-3 rounded-lg px-2.5 py-2 transition <%= group.isActive ? 'bg-cyan-50 text-cyan-800' : 'text-slate-800 hover:bg-slate-100' %>"
        >
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-xs font-bold <%= group.isActive ? 'bg-cyan-700 text-white' : 'bg-slate-200 text-slate-700' %>">
            <%= group.name.charAt(0).toUpperCase() %>
          </span>
          <span class="truncate text-sm font-semibold"><%= group.name %></span>
          <img src="/icons/dropdown.svg" alt="" aria-hidden="true" class="ml-auto shrink-0 transition group-open:rotate-180" style="width: 12px; height: 12px;" />
        </summary>

        <% if (Array.isArray(group.items) && group.items.length > 0) { %>
        <div class="mt-1 flex flex-wrap gap-1.5 pl-11 pr-1 pb-1">
          <a
            href="<%= buildCategoryHref(group.name) %>"
            class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-semibold transition-all duration-200 <%= group.isActive ? 'border-cyan-400 bg-cyan-50 text-cyan-700' : 'border-slate-300 bg-white text-slate-600 hover:-translate-y-0.5 hover:border-slate-400 hover:bg-slate-100' %>"
          >
            All <%= group.name %>
          </a>
          <% group.items.forEach(function(item) { %>
          <a
            href="<%= buildSubcategoryHref(group.name, item.label) %>"
            class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-medium transition-all duration-200 <%= item.isMatch ? 'border-cyan-400 bg-cyan-50 text-cyan-700' : 'border-slate-300 bg-white text-slate-600 hover:-translate-y-0.5 hover:border-slate-400 hover:bg-slate-100' %>"
          >
            <%= item.label %>
          </a>
          <% }) %>
        </div>
        <% } %>
      </details>
      <% }) %>
    </div>

    <% if (activeCategory) { %>
    <a href="<%= buildCategoryHref('') %>" class="pro-btn-secondary mt-4 w-full text-xs">
      Clear category filter: <%= activeCategory %>
    </a>
    <% } %>

    <% if (shouldShowUserAuthActions && !authenticatedUser) { %>
    <div class="mt-4 grid grid-cols-2 gap-2 lg:hidden">
      <a href="/login" class="<%= isLoginPath ? 'pro-btn-primary w-full' : 'pro-btn-secondary w-full' %> gap-1.5">
        <img
          src="<%= isLoginPath ? '/icons/login-white.svg' : '/icons/login-black.svg' %>"
          alt=""
          aria-hidden="true"
          class="shrink-0"
          style="width: 14px; height: 14px;"
        />
        <span>Login</span>
      </a>
      <a href="/signup" class="<%= isSignupPath ? 'pro-btn-primary w-full' : 'pro-btn-secondary w-full' %> gap-1.5">
        <img
          src="<%= isSignupPath ? '/icons/signup-white.svg' : '/icons/signup-black.svg' %>"
          alt=""
          aria-hidden="true"
          class="shrink-0"
          style="width: 14px; height: 14px;"
        />
        <span>Sign Up</span>
      </a>
    </div>
    <% } %>

    <% if (shouldShowUserAuthActions && authenticatedUser) { %>
    <div class="mt-4 rounded-xl border border-slate-200 bg-white p-2.5 lg:hidden">
      <a
        href="/profile"
        class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-800 transition hover:border-slate-300 hover:bg-slate-50"
      >
        <span class="inline-flex items-center gap-1.5">
          <img src="/icons/user.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 14px; height: 14px;" />
          <span>Profile</span>
        </span>
      </a>

      <a
        href="/my-orders"
        class="mt-2 flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-800 transition hover:border-slate-300 hover:bg-slate-50"
      >
        <span class="inline-flex items-center gap-1.5">
          <img src="/icons/myorder.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 14px; height: 14px;" />
          <span>My Order</span>
        </span>
      </a>

      <form action="/logout" method="post" class="mt-2">
        <button type="submit" class="flex w-full items-center justify-between rounded-xl border border-red-300 bg-red-50 px-3 py-2.5 text-sm font-semibold text-red-700 transition hover:bg-red-100">
          <span class="inline-flex items-center gap-1.5">
            <img src="/icons/logout.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 14px; height: 14px;" />
            <span>Logout</span>
          </span>
        </button>
      </form>
    </div>
    <% } %>
  </div>
</aside>

<button
  id="mobile-sidebar-backdrop"
  type="button"
  aria-label="Close categories panel"
  class="fixed inset-0 z-30 bg-slate-900/45 opacity-0 pointer-events-none backdrop-blur-[1px] transition-opacity duration-300 lg:hidden"
></button>

<script src="/javascripts/sidebar.js"></script>
