<%
  var resolvedBasePath = typeof basePath === 'string' ? basePath : '/';
  var currentBasePath = resolvedBasePath === '/home' ? '/home' : '/';

  function buildCategoryHref(categoryName) {
    var params = [];
    if (categoryName) {
      params.push('category=' + encodeURIComponent(categoryName));
    }
    return currentBasePath + (params.length ? '?' + params.join('&') : '');
  }

  var navCategorySource = typeof topNavCategories !== 'undefined' ? topNavCategories : [];
  var navCategories = Array.isArray(navCategorySource)
    ? navCategorySource
        .map(function (group) {
          return group && group.name ? String(group.name) : '';
        })
        .filter(Boolean)
    : ['Helmet', 'Engine Oil', 'Tyres', 'Grease', 'Chain Sprocket', 'Shock'];

  var normalizedActiveCategory = (activeCategory || '').toLowerCase();
  var sidebarEnabled = typeof hasSidebar !== 'undefined' ? hasSidebar : false;
  var shouldShowUserAuthActions = typeof showUserAuthActions !== 'undefined' ? Boolean(showUserAuthActions) : false;
  var currentPathname = typeof currentPath === 'string' ? currentPath : '';
  var isLoginPath = currentPathname === '/login';
  var isSignupPath = currentPathname === '/signup';
  var authenticatedUser = typeof currentUser !== 'undefined' && currentUser && currentUser.email ? currentUser : null;
  var userDisplayName = authenticatedUser ? (authenticatedUser.name || authenticatedUser.email) : '';
  var userInitial = userDisplayName ? userDisplayName.charAt(0).toUpperCase() : 'U';
%>

<nav id="site-navbar" class="sticky top-0 z-50 border-b border-slate-200/80 bg-slate-50/80 backdrop-blur transition-all duration-300">
  <div class="app-shell py-3">
    <div class="pro-panel px-3 py-3 sm:px-4 pro-page-enter">
      <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center pro-stagger">
        <div class="flex min-w-0 items-center gap-2.5">
          <% if (sidebarEnabled) { %>
          <button
            id="mobile-sidebar-open"
            type="button"
            aria-label="Open categories"
            aria-controls="mobile-category-sidebar"
            aria-expanded="false"
            class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-700 transition hover:border-slate-400 hover:bg-slate-100"
          >
            <img data-sidebar-toggle-icon-open src="/icons/hamburger.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 18px; height: 18px;" />
            <img data-sidebar-toggle-icon-close src="/icons/close.svg" alt="" aria-hidden="true" class="hidden shrink-0" style="width: 18px; height: 18px;" />
          </button>
          <% } %>

          <a href="<%= currentBasePath %>" class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-slate-900 px-3 py-2 text-white shadow-sm hover:-translate-y-0.5 hover:shadow-md">
            <img src="/icons/logo.svg" alt="BhutanDevi logo" class="h-7 w-7 rounded-full bg-white p-1" />
            <span class="hidden whitespace-nowrap text-[11px] font-bold tracking-wide text-slate-100 sm:block">bhutandevitradeandsuppliers</span>
          </a>

          <form action="<%= currentBasePath %>" method="get" class="min-w-0 flex-1">
            <label for="search-input" class="sr-only">Search products</label>
            <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-1.5 shadow-sm transition-all duration-200 focus-within:border-cyan-300 focus-within:shadow-md">
              <input
                id="search-input"
                type="search"
                name="q"
                value="<%= q || '' %>"
                placeholder="Search products, categories, or brands"
                class="w-full border-0 bg-transparent px-1 py-2 text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none"
              />
              <button type="submit" aria-label="Search" class="pro-btn-primary px-2.5 py-1.5">
                <img src="/icons/search.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 14px; height: 14px;" />
                <span class="sr-only">Search</span>
              </button>
            </div>
          </form>
        </div>

        <div class="hidden min-w-0 items-center justify-end gap-2 pb-1 lg:flex">
          <div class="relative min-w-0 flex-1" style="max-width: 36rem;">
            <div data-nav-categories-scroller class="flex min-w-0 items-center gap-2 overflow-x-auto pro-scrollbar" style="padding-right: 2.5rem;">
              <% navCategories.forEach(function (categoryName) { %>
              <% var normalizedNavCategory = String(categoryName || '').toLowerCase(); %>
              <a
                href="<%= buildCategoryHref(categoryName) %>"
                title="<%= categoryName %>"
                class="inline-flex shrink-0 items-center gap-2 rounded-xl border px-3 py-2 text-xs font-semibold transition <%= normalizedActiveCategory === normalizedNavCategory ? 'border-cyan-500 bg-cyan-50 text-cyan-800 shadow-sm' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-800' %>"
                style="width: 8.25rem;"
              >
                <span
                  class="inline-flex h-6 w-6 items-center justify-center rounded-lg text-[11px] font-bold <%= normalizedActiveCategory === normalizedNavCategory ? 'bg-cyan-700 text-white' : 'bg-slate-200 text-slate-600' %>"
                >
                  <%= String(categoryName).charAt(0).toUpperCase() %>
                </span>
                <span class="truncate"><%= categoryName %></span>
              </a>
              <% }) %>
            </div>

            <% if (navCategories.length > 4) { %>
            <button
              type="button"
              data-nav-categories-next
              aria-label="Scroll categories"
              class="absolute right-0 top-1/2 z-20 inline-flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-slate-300 bg-white shadow-sm transition hover:border-slate-400 hover:bg-slate-100"
            >
              <img src="/icons/right-arrow.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 12px; height: 12px;" />
            </button>
            <% } %>
          </div>

          <% if (shouldShowUserAuthActions && authenticatedUser) { %>
          <div class="relative ml-1 shrink-0 border-l border-slate-200 pl-2" data-user-menu-root>
            <button
              type="button"
              data-user-menu-toggle
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label="Open account menu"
              class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-300 bg-white text-slate-700 shadow-sm transition hover:border-slate-400 hover:bg-slate-100"
            >
              <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-slate-900 text-[11px] font-bold text-white"><%= userInitial %></span>
            </button>

            <div
              data-user-menu-panel
              role="menu"
              class="absolute right-0 top-[calc(100%+0.5rem)] z-[60] hidden w-[17rem] rounded-2xl border border-slate-200 bg-white p-2 shadow-2xl"
            >
              <a
                href="/profile"
                role="menuitem"
                class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-800 transition hover:border-slate-300 hover:bg-slate-50"
              >
                <span class="inline-flex items-center gap-1.5">
                  <img src="/icons/user.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 14px; height: 14px;" />
                  <span>Profile</span>
                </span>
              </a>

              <a
                href="/my-orders"
                role="menuitem"
                class="mt-2 flex items-center justify-between rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-800 transition hover:border-slate-300 hover:bg-slate-50"
              >
                <span class="inline-flex items-center gap-1.5">
                  <img src="/icons/myorder.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 14px; height: 14px;" />
                  <span>My Order</span>
                </span>
              </a>

              <form action="/logout" method="post" class="mt-2">
                <button type="submit" role="menuitem" class="flex w-full items-center justify-between rounded-xl border border-red-300 bg-red-50 px-3 py-2.5 text-sm font-semibold text-red-700 transition hover:bg-red-100">
                  <span class="inline-flex items-center gap-1.5">
                    <img src="/icons/logout.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 14px; height: 14px;" />
                    <span>Logout</span>
                  </span>
                </button>
              </form>
            </div>
          </div>
          <% } %>

          <% if (shouldShowUserAuthActions && !authenticatedUser) { %>
          <div class="ml-1 flex shrink-0 items-center gap-2 border-l border-slate-200 pl-2">
            <a href="/login" class="<%= isLoginPath ? 'pro-btn-primary px-3 py-1.5 text-xs' : 'pro-btn-secondary px-3 py-1.5 text-xs' %> gap-1.5">
              <img
                src="<%= isLoginPath ? '/icons/login-white.svg' : '/icons/login-black.svg' %>"
                alt=""
                aria-hidden="true"
                class="shrink-0"
                style="width: 14px; height: 14px;"
              />
              <span>Login</span>
            </a>
            <a href="/signup" class="<%= isSignupPath ? 'pro-btn-primary px-3 py-1.5 text-xs' : 'pro-btn-secondary px-3 py-1.5 text-xs' %> gap-1.5">
              <img
                src="<%= isSignupPath ? '/icons/signup-white.svg' : '/icons/signup-black.svg' %>"
                alt=""
                aria-hidden="true"
                class="shrink-0"
                style="width: 14px; height: 14px;"
              />
              <span>Sign Up</span>
            </a>
          </div>
          <% } %>
        </div>
      </div>

      <% /* Mobile auth actions are handled in sidebar. */ %>
    </div>
  </div>
</nav>

<% /* Mobile Bottom Navigation Bar */ %>
<div class="fixed bottom-0 left-0 right-0 z-[60] border-t border-slate-200 bg-white px-2 py-2 shadow-[0_-4px_20px_rgba(15,23,42,0.08)] lg:hidden">
  <div class="flex items-center justify-around">
    <% /* Home */ %>
    <a href="<%= currentBasePath %>" class="flex flex-col items-center gap-0.5 rounded-lg px-3 py-1.5 transition <%= currentPathname === currentBasePath || currentPathname === '/' ? 'text-cyan-700' : 'text-slate-500 hover:text-slate-700' %>">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span class="text-[10px] font-medium">Home</span>
    </a>

    <% /* Categories - opens sidebar */ %>
    <% if (sidebarEnabled) { %>
    <button type="button" id="mobile-nav-categories" class="flex flex-col items-center gap-0.5 rounded-lg px-3 py-1.5 text-slate-500 transition hover:text-slate-700">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v18H3zM9 3v18"/><path d="M15 9h6"/><path d="M15 15h6"/></svg>
      <span class="text-[10px] font-medium">Categories</span>
    </button>
    <% } %>

    <% /* Orders */ %>
    <% if (authenticatedUser) { %>
    <a href="/my-orders" class="flex flex-col items-center gap-0.5 rounded-lg px-3 py-1.5 transition <%= currentPathname === '/my-orders' ? 'text-cyan-700' : 'text-slate-500 hover:text-slate-700' %>">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      <span class="text-[10px] font-medium">Orders</span>
    </a>
    <% } %>

    <% /* Profile / Account */ %>
    <% if (authenticatedUser) { %>
    <a href="/profile" class="flex flex-col items-center gap-0.5 rounded-lg px-3 py-1.5 transition <%= currentPathname === '/profile' ? 'text-cyan-700' : 'text-slate-500 hover:text-slate-700' %>">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <span class="text-[10px] font-medium">Profile</span>
    </a>
    <% } else { %>
    <a href="/login" class="flex flex-col items-center gap-0.5 rounded-lg px-3 py-1.5 transition <%= currentPathname === '/login' ? 'text-cyan-700' : 'text-slate-500 hover:text-slate-700' %>">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></svg>
      <span class="text-[10px] font-medium">Login</span>
    </a>
    <% } %>
  </div>
</div>

<% /* Add padding to body for mobile bottom nav */ %>
<style>
  @media (max-width: 1023px) {
    body {
      padding-bottom: 4rem;
    }
  }
</style>

<script src="/javascripts/nav.js"></script>
