<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="<%= assetPath('/javascripts/home-head.js') %>"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="<%= assetPath('/stylesheets/style.css') %>" />
  </head>
  <body class="text-slate-900">
    <% if (statusMessage) { %>
    <div class="hidden" data-success-alert><%= statusMessage %></div>
    <% } %>

    <%- include('helpers/nav', { title, q, activeCategory, hasSidebar: true, topNavCategories: categoryGroups, searchSuggestions, basePath, currentPath, currentUser, showUserAuthActions }) %>

    <main class="app-shell py-4 sm:py-6">
      <div id="home-layout-grid" class="grid gap-5 lg:grid-cols-[20rem_minmax(0,1fr)]">
        <%- include('helpers/sidebar', { categoryGroups, hasQuery, q, activeCategory, openCategoryName, basePath, currentUser, showUserAuthActions, currentPath }) %>

        <section class="min-w-0 pro-page-enter">
          <!-- Skeleton product cards for homepage during global loading -->
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-skeleton-card-grid>
            <article data-skeleton-target class="pro-grid-card is-loading hidden">
              <div class="pro-card-skeleton" aria-hidden="true">
                <span class="pro-skeleton-block pro-skeleton-media"></span>
                <div class="flex items-start justify-between gap-2 mt-2">
                  <span class="pro-skeleton-block pro-skeleton-title w-32"></span>
                  <span class="pro-skeleton-block pro-skeleton-tag w-12"></span>
                </div>
                <span class="pro-skeleton-block pro-skeleton-line mt-2"></span>
                <span class="pro-skeleton-block pro-skeleton-line-sm mt-1"></span>
                <div class="mt-auto flex items-end justify-between gap-2">
                  <span class="pro-skeleton-block pro-skeleton-price w-20"></span>
                  <span class="pro-skeleton-block pro-skeleton-btn w-16"></span>
                </div>
              </div>
            </article>
            <article data-skeleton-target class="pro-grid-card is-loading hidden">
              <div class="pro-card-skeleton" aria-hidden="true">
                <span class="pro-skeleton-block pro-skeleton-media"></span>
                <div class="flex items-start justify-between gap-2 mt-2">
                  <span class="pro-skeleton-block pro-skeleton-title w-28"></span>
                  <span class="pro-skeleton-block pro-skeleton-tag w-12"></span>
                </div>
                <span class="pro-skeleton-block pro-skeleton-line mt-2"></span>
                <span class="pro-skeleton-block pro-skeleton-line-sm mt-1"></span>
                <div class="mt-auto flex items-end justify-between gap-2">
                  <span class="pro-skeleton-block pro-skeleton-price w-20"></span>
                  <span class="pro-skeleton-block pro-skeleton-btn w-16"></span>
                </div>
              </div>
            </article>
            <article data-skeleton-target class="pro-grid-card is-loading hidden">
              <div class="pro-card-skeleton" aria-hidden="true">
                <span class="pro-skeleton-block pro-skeleton-media"></span>
                <div class="flex items-start justify-between gap-2 mt-2">
                  <span class="pro-skeleton-block pro-skeleton-title w-36"></span>
                  <span class="pro-skeleton-block pro-skeleton-tag w-12"></span>
                </div>
                <span class="pro-skeleton-block pro-skeleton-line mt-2"></span>
                <span class="pro-skeleton-block pro-skeleton-line-sm mt-1"></span>
                <div class="mt-auto flex items-end justify-between gap-2">
                  <span class="pro-skeleton-block pro-skeleton-price w-20"></span>
                  <span class="pro-skeleton-block pro-skeleton-btn w-16"></span>
                </div>
              </div>
            </article>
          </div>

          <%- include('singleProduct', { q, activeCategory, productSections, showCarousel, carouselImages, storeCurrentPage, storeTotalPages, storePageSize, storeWhatsappNumber, basePath, currentUser }) %>
        </section>
      </div>
    </main>
    <%- include('helpers/footer', { basePath, currentPath, categoryGroups, currentUser }) %>

    <%- include('helpers/toaster') %>
    <script src="<%= assetPath('/javascripts/home.js') %>"></script>
    <script src="<%= assetPath('/javascripts/flash-alert.js') %>"></script>
  </body>
</html>
