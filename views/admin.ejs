<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="<%= assetPath('/stylesheets/style.css') %>" />
  </head>
  <body class="bg-slate-100/80 text-slate-900">
    <main class="app-shell grid gap-4 py-5 pro-page-enter sm:py-6">
      <%
        function toAnchor(value) {
          return String(value || '')
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }

        function toCount(value) {
          let parsed = Number(value);
          return Number.isFinite(parsed) ? parsed : 0;
        }

        function getCategoryItems(categoryName) {
          let categoryKey = toAnchor(categoryName);
          return categoryKey && Array.isArray(subcategoryOptionsByCategory[categoryKey])
            ? subcategoryOptionsByCategory[categoryKey]
            : [];
        }

        function getCategoryItemsText(categoryName) {
          return getCategoryItems(categoryName).join(', ');
        }

        function getEditableCategoryRecord(categoryName) {
          let categoryKey = toAnchor(categoryName);
          return categoryKey && adminCategoryRecords && typeof adminCategoryRecords === 'object'
            ? adminCategoryRecords[categoryKey] || null
            : null;
        }

        function getEditableCategoryItemsText(categoryName) {
          let editableRecord = getEditableCategoryRecord(categoryName);

          if (editableRecord && Array.isArray(editableRecord.items) && editableRecord.items.length) {
            return editableRecord.items.join(', ');
          }

          return getCategoryItemsText(categoryName);
        }

        let orderedBoards = Array.isArray(categoryBoards)
          ? categoryBoards.filter(function (board) {
              return board && board.name;
            })
          : [];
        let stats = dashboardStats && typeof dashboardStats === 'object' ? dashboardStats : {};
        let dashboardImageInputId = 'dashboard-product-image-file';
        let subcategoryOptionsByCategory = {};

        function addSubcategoryOption(categoryName, value) {
          let cleanedCategoryName = String(categoryName || '').trim();
          let cleanedValue = String(value || '').trim();
          let categoryKey = toAnchor(cleanedCategoryName);
          let optionKey = toAnchor(cleanedValue);

          if (!categoryKey || !cleanedValue || !optionKey) {
            return;
          }

          if (!Array.isArray(subcategoryOptionsByCategory[categoryKey])) {
            subcategoryOptionsByCategory[categoryKey] = [];
            subcategoryOptionsByCategory[categoryKey + ':seen'] = {};
          }

          if (subcategoryOptionsByCategory[categoryKey + ':seen'][optionKey]) {
            return;
          }

          subcategoryOptionsByCategory[categoryKey + ':seen'][optionKey] = true;
          subcategoryOptionsByCategory[categoryKey].push(cleanedValue);
        }

        orderedBoards.forEach(function (board) {
          (board.items || []).forEach(function (item) {
            addSubcategoryOption(board && board.name, item && item.name);
          });
        });

        if (Array.isArray(topNavCategories)) {
          topNavCategories.forEach(function (group) {
            (group.items || []).forEach(function (itemName) {
              addSubcategoryOption(group && group.name, itemName);
            });
          });
        }

        if (!Array.isArray(subcategoryOptionsByCategory.helmet) || !subcategoryOptionsByCategory.helmet.length) {
          subcategoryOptionsByCategory.helmet = ['Vega'];
        }

        Object.keys(subcategoryOptionsByCategory).forEach(function (key) {
          if (key.indexOf(':seen') !== -1) {
            delete subcategoryOptionsByCategory[key];
            return;
          }

          subcategoryOptionsByCategory[key].sort(function (left, right) {
            return left.localeCompare(right);
          });
        });
      %>

      <header class="pro-panel p-5 pro-stagger">
        <div class="flex flex-wrap items-start gap-4">
          <div class="min-w-0 flex-1 grid gap-1">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Control Center</p>
            <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Admin Dashboard</h1>
          </div>

          <nav class="flex w-full flex-wrap items-center gap-2 pt-1 sm:ml-auto sm:w-auto sm:justify-end sm:pt-0" aria-label="Admin navigation">
            <a href="/admin/orders" class="pro-btn-secondary py-2 pro-btn-sm">Order Requests</a>
            <a href="/admin/products" class="pro-btn-secondary py-2 pro-btn-sm">Products</a>
            <a href="/admin/profile" class="pro-btn-primary py-2 pro-btn-sm gap-1.5">
              Profile
            </a>
            <a href="/admin/logout" class="pro-btn-danger-muted pro-btn-sm py-2 gap-1.5">
              Logout
            </a>
          </nav>
        </div>
      </header>

      <% if (statusMessage) { %>
      <div class="hidden" data-success-alert><%= statusMessage %></div>
      <% } %>

      <% if (errorMessage) { %>
      <div class="hidden" data-error-alert><%= errorMessage %></div>
      <% } %>

      <section class="grid gap-3 sm:grid-cols-2 sm:auto-rows-fr xl:grid-cols-4 pro-stagger">
        <article class="pro-panel grid h-full gap-1 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Categories</p>
          <p class="text-3xl font-extrabold text-slate-900" data-dashboard-total-categories><%= toCount(stats.totalCategories) %></p>
          <p class="text-xs text-slate-500"><span data-dashboard-empty-categories><%= toCount(stats.emptyCategories) %></span> empty categories</p>
        </article>
        <article class="pro-panel grid h-full gap-1 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Products</p>
          <p class="text-3xl font-extrabold text-slate-900"><%= toCount(stats.totalProducts) %></p>
          <p class="text-xs text-slate-500"><%= toCount(stats.adminOnlyProducts) %> admin-added</p>
        </article>
        <article class="pro-panel grid h-full gap-1 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Overrides</p>
          <p class="text-3xl font-extrabold text-slate-900"><%= toCount(stats.productOverrides) %></p>
          <p class="text-xs text-slate-500"><%= toCount(stats.priceOverrides) %> price, <%= toCount(stats.imageOverrides) %> image</p>
        </article>
        <article class="pro-panel grid h-full gap-1 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Deleted</p>
          <p class="text-3xl font-extrabold text-slate-900"><%= toCount(stats.deletedProductIds) %></p>
          <p class="text-xs text-slate-500"><%= toCount(stats.deletedCategoryNames) %> categories deleted</p>
        </article>
      </section>

      <section class="grid items-start gap-4 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] pro-stagger">
        <section class="pro-panel h-fit p-5">
          <div class="grid gap-4">
            <div class="grid gap-1">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Categories</p>
              <h2 class="text-xl font-extrabold tracking-tight text-slate-900">Create or rename a category</h2>
              <p class="text-sm text-slate-600">Use this form to add a new category or switch into edit mode from any category card below.</p>
            </div>

            <form action="/admin/categories" method="post" class="grid gap-4" data-category-form>
              <input type="hidden" name="redirectTo" value="/admin" />
              <input type="hidden" name="originalCategoryName" value="" data-category-original-name-input />
              <input type="hidden" name="replaceCategoryItems" value="0" data-category-replace-items-input />

              <div class="grid gap-1.5">
                <label for="admin-category-name" class="text-sm font-semibold text-slate-800">Category name</label>
                <input
                  id="admin-category-name"
                  type="text"
                  name="categoryName"
                  data-category-name-input
                  required
                  placeholder="Category name"
                  class="pro-input"
                />
              </div>

              <div class="grid gap-1.5">
                <label for="admin-category-items" class="text-sm font-semibold text-slate-800">Items / subcategories</label>
                <textarea
                  id="admin-category-items"
                  name="categoryItems"
                  data-category-items-input
                  rows="4"
                  placeholder="Optional items, comma separated"
                  class="pro-input"
                ></textarea>
                <p class="text-xs text-slate-500">Example: Vega, Full Face, Open Face</p>
              </div>

              <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Editing</p>
                <p class="pt-2 text-sm text-slate-600">Pick any category card below to load it into this form. Saving here also handles category renames.</p>
              </div>

              <div class="grid w-full gap-2 sm:grid-cols-2">
                <button
                  type="submit"
                  data-category-submit-button
                  class="pro-btn-primary py-2 w-full justify-center"
                >
                  Save Category
                </button>
                <button
                  type="button"
                  data-category-edit-cancel
                  class="pro-btn-secondary hidden py-2 w-full justify-center"
                >
                  Cancel Edit
                </button>
              </div>
            </form>

            <!-- Quick-add form skeleton shown during global loading -->
            <div data-skeleton-target class="hidden">
              <div class="pro-card-skeleton p-4" aria-hidden="true">
                <span class="pro-skeleton-block pro-skeleton-title w-48"></span>
                <div class="mt-3 grid gap-2">
                  <span class="pro-skeleton-block pro-skeleton-line"></span>
                  <span class="pro-skeleton-block pro-skeleton-line-sm w-3/4"></span>
                  <div class="flex items-center gap-3 mt-2">
                    <span class="pro-skeleton-block pro-skeleton-media w-18 h-18"></span>
                    <div class="flex-1">
                      <span class="pro-skeleton-block pro-skeleton-line-sm"></span>
                      <span class="pro-skeleton-block pro-skeleton-line-sm w-1/2 mt-1"></span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="pro-panel p-5">
          <div class="grid gap-4">
            <div class="grid gap-1">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Products</p>
              <h2 class="text-xl font-extrabold tracking-tight text-slate-900">Quick Add Product</h2>
              <p class="text-sm text-slate-600">Fast product entry for the dashboard. Full product management stays on the products page.</p>
            </div>

            <form action="/admin/products" method="post" enctype="multipart/form-data" class="grid gap-4 lg:grid-cols-2">
              <input type="hidden" name="redirectTo" value="/admin" />

              <div class="grid gap-1.5">
                <label for="quick-add-category-input" class="text-sm font-semibold text-slate-800">Category</label>
                <select
                  id="quick-add-category-input"
                  data-product-category-input
                  name="productCategory"
                  required
                  class="pro-input"
                >
                  <option value="" selected>Select category</option>
                  <% orderedBoards.forEach(function (board) { %>
                  <option value="<%= board.name %>"><%= board.name %></option>
                  <% }) %>
                </select>
              </div>

              <div class="grid gap-1.5">
                <label for="quick-add-subcategory-input" class="text-sm font-semibold text-slate-800">Product / subcategory</label>
                <select
                  id="quick-add-subcategory-input"
                  data-product-subcategory-picker
                  name="productName"
                  required
                  class="pro-input"
                >
                  <option value="">Select subcategory</option>
                </select>
                <input
                  type="text"
                  id="quick-add-subcategory-custom-input"
                  data-product-subcategory-custom-input
                  name="productName"
                  disabled
                  placeholder="Enter subcategory title"
                  class="pro-input hidden"
                />
              </div>

              <div class="grid gap-1.5">
                <label for="quick-add-price-input" class="text-sm font-semibold text-slate-800">MRP</label>
                <input
                  id="quick-add-price-input"
                  type="number"
                  name="productPrice"
                  data-product-mrp-input
                  min="0"
                  step="0.01"
                  required
                  placeholder="1500"
                  class="pro-input"
                />
              </div>

              <div class="grid gap-1.5">
                <label for="quick-add-discount-input" class="text-sm font-semibold text-slate-800">Discount %</label>
                <input
                  id="quick-add-discount-input"
                  type="number"
                  name="productDiscountPercent"
                  data-product-discount-input
                  min="0"
                  max="100"
                  step="0.01"
                  value="0"
                  placeholder="0"
                  class="pro-input"
                />
              </div>

              <div class="grid gap-1.5">
                <label for="quick-add-quantity-input" class="text-sm font-semibold text-slate-800">Quantity</label>
                <input
                  id="quick-add-quantity-input"
                  type="number"
                  name="productQuantity"
                  min="0"
                  step="1"
                  required
                  placeholder="Quantity"
                  class="pro-input"
                />
              </div>

              <div class="grid gap-1.5">
                <label for="quick-add-spec-input" class="text-sm font-semibold text-slate-800">Description</label>
                <input
                  id="quick-add-spec-input"
                  type="text"
                  name="productSpec"
                  placeholder="Short product description"
                  class="pro-input"
                />
              </div>

              <div class="hidden rounded-xl border border-slate-200 bg-slate-50 px-4 py-2 lg:col-span-2" data-product-price-preview>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Price Preview</p>
                <div class="flex flex-wrap items-baseline gap-2 pt-2">
                  <span data-product-price-final class="text-lg font-bold text-slate-900"></span>
                  <span data-product-price-original class="hidden text-sm font-semibold text-slate-400 line-through"></span>
                </div>
              </div>

              <div class="grid gap-2.5 lg:col-span-2">
                <label for="<%= dashboardImageInputId %>" class="text-sm font-semibold text-slate-800">Product photo</label>
                <div class="grid gap-2 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4 transition hover:border-slate-400">
                  <input
                    id="<%= dashboardImageInputId %>"
                    type="file"
                    name="productImageFile"
                    accept="image/*"
                    required
                    data-file-input
                    class="sr-only"
                  />
                  <label for="<%= dashboardImageInputId %>" class="pro-btn-secondary w-full justify-center px-4 py-2 text-sm">
                    Upload Photo
                  </label>
                  <div class="flex items-center gap-3">
                    <div class="overflow-hidden rounded-md border border-slate-200 bg-white p-1" style="width:72px; height:72px;">
                      <img
                        src=""
                        alt="Preview"
                        class="h-full w-full object-contain hidden"
                        data-image-preview-for="<%= dashboardImageInputId %>"
                      />
                    </div>
                    <span data-file-name-for="<%= dashboardImageInputId %>" data-file-default-text="No photo selected" class="break-all text-xs font-medium text-slate-600">
                      No photo selected
                    </span>
                  </div>
                  <p class="text-xs text-slate-500">Use a clear JPG, PNG, or WEBP product image.</p>
                </div>
              </div>

              <div class="grid gap-2 lg:col-span-2 sm:grid-cols-2">
                <button type="submit" class="pro-btn-primary py-2 w-full justify-center">
                  Add Product
                </button>
                <button
                  type="button"
                  data-clear-quick-add
                  class="pro-btn-secondary py-2 w-full justify-center hidden"
                >
                  Clear
                </button>
                  <button type="button" data-clear-quick-add class="pro-btn-secondary py-2 w-full justify-center hidden">
                    Clear
                </button>
              </div>
            </form>
          </div>
        </section>
      </section>

    </main>

    <div id="delete-alert" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4">
      <div class="pro-panel w-full max-w-md p-5">
        <h3 class="text-lg font-bold text-slate-900" id="delete-alert-title">Delete</h3>
        <p class="pt-2 text-sm text-slate-700" id="delete-alert-message">Are you sure you want to delete this category?</p>
        <div class="flex items-center justify-end gap-2 pt-4">
          <button
            type="button"
            id="delete-alert-cancel"
            class="pro-btn-secondary"
          >
            Cancel
          </button>
          <button
            type="button"
            id="delete-alert-confirm"
            class="pro-btn-danger"
          >
            Delete
          </button>
        </div>
      </div>
    </div>

    <%- include('helpers/loading') %>
    <%- include('helpers/toaster') %>
    <script id="admin-page-data" type="application/json"><%- JSON.stringify({ subcategoryOptionsByCategory: subcategoryOptionsByCategory }).replace(/</g, '\\u003c') %></script>
    <script src="<%= assetPath('/javascripts/loading.js') %>"></script>
    <script src="<%= assetPath('/javascripts/flash-alert.js') %>"></script>
    <script src="<%= assetPath('/javascripts/admin.js') %>"></script>
  </body>
</html>
