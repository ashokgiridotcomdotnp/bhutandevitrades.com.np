<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="text-slate-900">
    <main class="app-shell py-6 pro-page-enter">
      <%
        function toAnchor(value) {
          return String(value || '')
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }

        function toCount(value) {
          var parsed = Number(value);
          return Number.isFinite(parsed) ? parsed : 0;
        }

        var orderedBoards = Array.isArray(categoryBoards)
          ? categoryBoards.filter(function (board) {
              return board && board.name;
            })
          : [];
        var stats = dashboardStats && typeof dashboardStats === 'object' ? dashboardStats : {};
        var defaultCategoryName = orderedBoards.length ? orderedBoards[0].name : '';
        var dashboardImageInputId = 'dashboard-product-image-file';
        var subcategoryOptionsByCategory = {};
        var productRows = [];
        var productOrderById = adminProductOrderById && typeof adminProductOrderById === 'object' ? adminProductOrderById : {};

        function addSubcategoryOption(categoryName, value) {
          var cleanedCategoryName = String(categoryName || '').trim();
          var cleanedValue = String(value || '').trim();
          var categoryKey = toAnchor(cleanedCategoryName);
          var optionKey = toAnchor(cleanedValue);

          if (!categoryKey || !cleanedValue || !optionKey) {
            return;
          }

          if (!Array.isArray(subcategoryOptionsByCategory[categoryKey])) {
            subcategoryOptionsByCategory[categoryKey] = [];
            subcategoryOptionsByCategory[categoryKey + ':seen'] = {};
          }

          if (subcategoryOptionsByCategory[categoryKey + ':seen'][optionKey]) {
            return;
          }

          subcategoryOptionsByCategory[categoryKey + ':seen'][optionKey] = true;
          subcategoryOptionsByCategory[categoryKey].push(cleanedValue);
        }

        orderedBoards.forEach(function (board) {
          (board.items || []).forEach(function (item) {
            addSubcategoryOption(board && board.name, item && item.name);
          });
        });

        if (Array.isArray(topNavCategories)) {
          topNavCategories.forEach(function (group) {
            (group.items || []).forEach(function (itemName) {
              addSubcategoryOption(group && group.name, itemName);
            });
          });
        }

        if (!Array.isArray(subcategoryOptionsByCategory.helmet) || !subcategoryOptionsByCategory.helmet.length) {
          subcategoryOptionsByCategory.helmet = ['Vega'];
        }

        Object.keys(subcategoryOptionsByCategory).forEach(function (key) {
          if (key.indexOf(':seen') !== -1) {
            delete subcategoryOptionsByCategory[key];
            return;
          }

          subcategoryOptionsByCategory[key].sort(function (left, right) {
            return left.localeCompare(right);
          });
        });

        orderedBoards.forEach(function (board) {
          var boardItems = Array.isArray(board.items) ? board.items : [];

          boardItems.forEach(function (item) {
            if (!item || !item.id) {
              return;
            }

            productRows.push({
              id: item.id,
              categoryName: board.name,
              name: item.name,
              spec: item.spec,
              price: item.price,
              image: item.image,
              addedOrder: Number(productOrderById[item.id]) || 0,
            });
          });
        });

        productRows.sort(function (a, b) {
          return (
            (Number(b.addedOrder) - Number(a.addedOrder)) ||
            String(a.categoryName || '').localeCompare(String(b.categoryName || '')) ||
            String(a.name || '').localeCompare(String(b.name || ''))
          );
        });

        var parsedOverviewPageSize = Number(productOverviewPageSize);
        var resolvedOverviewPageSize = Number.isFinite(parsedOverviewPageSize) && parsedOverviewPageSize > 0
          ? Math.floor(parsedOverviewPageSize)
          : 20;
        var overviewTotalPages = Math.max(1, Math.ceil(productRows.length / resolvedOverviewPageSize));
        var parsedOverviewCurrentPage = Number(productOverviewPage);
        var overviewCurrentPage = Number.isFinite(parsedOverviewCurrentPage) && parsedOverviewCurrentPage > 0
          ? Math.floor(parsedOverviewCurrentPage)
          : 1;

        if (overviewCurrentPage > overviewTotalPages) {
          overviewCurrentPage = overviewTotalPages;
        }

        var overviewStartIndex = (overviewCurrentPage - 1) * resolvedOverviewPageSize;
        var overviewRows = productRows.slice(overviewStartIndex, overviewStartIndex + resolvedOverviewPageSize);

        function buildAdminProductsPageHref(targetPage) {
          var safeTargetPage = Number(targetPage);

          if (!Number.isFinite(safeTargetPage) || safeTargetPage < 1) {
            safeTargetPage = 1;
          }

          safeTargetPage = Math.floor(safeTargetPage);

          if (safeTargetPage <= 1) {
            return '/admin';
          }

          return '/admin?productsPage=' + safeTargetPage;
        }

        var adminProductsRedirectPath = buildAdminProductsPageHref(overviewCurrentPage);
      %>

      <header class="mb-5 pro-panel px-6 py-5 pro-stagger">
        <div class="flex flex-wrap items-center gap-3">
          <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Admin Dashboard</h1>
            <p class="mt-0.5 text-sm text-slate-600">Manage categories and products from one place.</p>
          </div>

          <div class="ml-auto flex flex-wrap items-center gap-2">
            <a
              href="/"
              class="pro-btn-secondary"
            >
              View Storefront
            </a>
            <a
              href="/admin/orders"
              class="pro-btn-secondary"
            >
              Order Requests
            </a>
            <form action="/admin/logout" method="post">
              <button type="submit" class="pro-btn-secondary gap-1.5">
                <img src="/icons/logout.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 14px; height: 14px;" />
                <span>Logout</span>
              </button>
            </form>
            <% if (defaultCategoryName) { %>
            <a
              href="/admin/categories/<%= toAnchor(defaultCategoryName) %>"
              class="pro-btn-primary"
            >
              Open Category Workspace
            </a>
            <% } %>
          </div>
        </div>
      </header>

      <% if (statusMessage) { %>
      <div
        data-success-alert
        role="status"
        class="rounded-xl border border-emerald-300 bg-emerald-50/95 px-4 py-2.5 text-sm font-semibold text-emerald-700 shadow-lg backdrop-blur"
      >
        <%= statusMessage %>
      </div>
      <% } %>

      <% if (errorMessage) { %>
      <div class="mb-4 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" data-error-alert>
        <%= errorMessage %>
      </div>
      <% } %>

      <section class="mb-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4 pro-stagger">
        <article class="pro-panel h-full p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Categories</p>
          <p class="mt-2 text-3xl font-extrabold text-slate-900"><%= toCount(stats.totalCategories) %></p>
          <p class="mt-1 text-xs text-slate-500"><%= toCount(stats.emptyCategories) %> empty categories</p>
        </article>
        <article class="pro-panel h-full p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Products</p>
          <p class="mt-2 text-3xl font-extrabold text-slate-900"><%= toCount(stats.totalProducts) %></p>
          <p class="mt-1 text-xs text-slate-500"><%= toCount(stats.adminOnlyProducts) %> admin-added</p>
        </article>
        <article class="pro-panel h-full p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Overrides</p>
          <p class="mt-2 text-3xl font-extrabold text-slate-900"><%= toCount(stats.productOverrides) %></p>
          <p class="mt-1 text-xs text-slate-500"><%= toCount(stats.priceOverrides) %> price, <%= toCount(stats.imageOverrides) %> image</p>
        </article>
        <article class="pro-panel p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Deleted</p>
          <p class="mt-2 text-3xl font-extrabold text-slate-900"><%= toCount(stats.deletedProductIds) %></p>
          <p class="mt-1 text-xs text-slate-500"><%= toCount(stats.deletedCategoryNames) %> categories deleted</p>
        </article>
      </section>

      <section class="mb-4 grid gap-4 xl:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] pro-stagger">
        <article class="pro-panel h-full p-4">
          <h2 class="text-xl font-extrabold tracking-tight text-slate-900">Create Category</h2>
          <form action="/admin/categories" method="post" class="mt-3 grid gap-2 md:grid-cols-2">
            <input type="hidden" name="redirectTo" value="<%= adminProductsRedirectPath %>" />
            <input
              type="text"
              name="categoryName"
              required
              placeholder="Category name"
              class="pro-input"
            />
            <input
              type="text"
              name="categoryDescription"
              placeholder="Description (optional)"
              class="pro-input"
            />
            <textarea
              name="categoryItems"
              rows="2"
              placeholder="Optional items, comma separated"
              class="md:col-span-2 pro-input"
            ></textarea>
            <button
              type="submit"
              class="pro-btn-primary"
            >
              Save Category
            </button>
          </form>
        </article>

        <article class="pro-panel h-full p-4">
          <h3 class="text-xl font-extrabold tracking-tight text-slate-900">Quick Add Product</h3>
          <form action="/admin/products" method="post" enctype="multipart/form-data" class="mt-3 grid items-start gap-3 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_20rem]">
            <input type="hidden" name="redirectTo" value="<%= adminProductsRedirectPath %>" />

            <div class="grid content-start gap-2 md:grid-cols-2 xl:col-span-2">
              <select
                id="quick-add-category-input"
                data-product-category-input
                name="productCategory"
                required
                class="pro-input"
              >
                <option value="" selected>Select category</option>
                <% orderedBoards.forEach(function (board) { %>
                <option value="<%= board.name %>"><%= board.name %></option>
                <% }) %>
              </select>

              <select
                id="quick-add-subcategory-input"
                data-product-subcategory-picker
                name="productName"
                required
                class="pro-input"
              >
                <option value="">Select subcategory</option>
              </select>
              <input
                type="text"
                id="quick-add-subcategory-custom-input"
                data-product-subcategory-custom-input
                name="productName"
                disabled
                placeholder="Enter subcategory title (e.g. Vega)"
                class="pro-input hidden md:col-span-2"
              />

              <div class="hidden md:col-span-2" data-helmet-coverage-container>
                <select
                  id="quick-add-helmet-coverage"
                  name="productHelmetCoverage"
                  data-helmet-coverage-picker
                  class="w-full pro-input"
                >
                  <option value="">Helmet type (Half / Full)</option>
                  <option value="Half">Half</option>
                  <option value="Full">Full</option>
                </select>
              </div>
              <input
                type="number"
                name="productPrice"
                data-product-mrp-input
                min="0"
                step="0.01"
                required
                placeholder="MRP (e.g. 1500)"
                class="pro-input"
              />
              <input
                type="number"
                name="productDiscountPercent"
                data-product-discount-input
                min="0"
                max="100"
                step="0.01"
                value="0"
                placeholder="Discount % (optional)"
                class="pro-input"
              />
              <div class="hidden md:col-span-2 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2" data-product-price-preview>
                <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Price Preview</p>
                <div class="mt-1 flex items-end gap-2">
                  <span class="hidden text-sm font-semibold text-red-600 line-through" data-product-price-original></span>
                  <span class="text-lg font-extrabold text-emerald-700" data-product-price-final></span>
                </div>
              </div>
            </div>

            <div class="space-y-2 xl:row-span-2">
              <div class="pro-file-zone flex flex-wrap items-center gap-2">
                <input
                  id="<%= dashboardImageInputId %>"
                  type="file"
                  name="productImageFile"
                  accept="image/*"
                  required
                  data-file-input
                  class="sr-only"
                />
                <label
                  for="<%= dashboardImageInputId %>"
                  class="pro-btn-secondary px-3 py-1.5 text-xs"
                >
                  Choose Product Photo
                </label>
                <span data-file-name-for="<%= dashboardImageInputId %>" data-file-default-text="No photo chosen" class="text-sm text-slate-600">
                  No photo chosen
                </span>
              </div>

              <button
                type="submit"
                class="pro-btn-primary w-full"
              >
                Add Product
              </button>
            </div>

            <div class="grid gap-2 md:grid-cols-2 xl:col-span-2">
              <input
                type="number"
                name="productQuantity"
                min="0"
                step="1"
                required
                placeholder="Quantity"
                class="pro-input"
              />
              <input
                type="text"
                name="productSpec"
                placeholder="Description"
                class="pro-input"
              />
            </div>
          </form>
        </article>
      </section>

      <section class="mb-4 pro-panel p-4 pro-stagger">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-xl font-extrabold tracking-tight text-slate-900">Categories</h2>
          <span class="ml-auto rounded-full border border-slate-300 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= orderedBoards.length %> categories</span>
        </div>

        <% if (!orderedBoards.length) { %>
        <div class="mt-3 rounded-lg border border-slate-300 bg-slate-50 px-4 py-3 text-sm text-slate-600">
          No categories available yet. Create your first category above.
        </div>
        <% } else { %>
        <div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3 pro-stagger">
          <% orderedBoards.forEach(function (board) { %>
          <%
            var boardItems = Array.isArray(board.items) ? board.items : [];
            var boardKey = toAnchor(board.name);
            var previewItems = boardItems.slice(0, 3);
          %>
          <article class="rounded-xl border border-slate-200 bg-slate-50/80 p-3 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-sm">
            <div class="flex items-start gap-2">
              <div class="min-w-0 flex-1">
                <h3 class="truncate text-lg font-bold text-slate-900"><%= board.name %></h3>
                <p class="text-xs text-slate-500"><%= boardItems.length %> products</p>
              </div>
              <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-bold text-blue-700"><%= boardItems.length %></span>
            </div>

            <% if (previewItems.length) { %>
            <ul class="mt-3 space-y-1.5">
              <% previewItems.forEach(function (item) { %>
              <li class="flex items-center justify-between gap-2 border-t border-slate-200 pt-1.5">
                <span class="truncate text-sm font-medium text-slate-800"><%= item.name || 'Untitled Product' %></span>
                <span class="shrink-0 text-sm font-semibold text-slate-700"><%= item.price || '-' %></span>
              </li>
              <% }) %>
            </ul>
            <% } else { %>
            <p class="mt-3 text-xs text-slate-500">No products in this category yet.</p>
            <% } %>

            <div class="mt-3 flex items-center gap-2">
              <a
                href="/admin/categories/<%= boardKey %>"
                class="pro-btn-secondary flex-1 px-3 py-1.5 text-xs"
              >
                Manage
              </a>
              <button
                type="button"
                data-delete-category-trigger="<%= boardKey %>"
                data-category-name="<%= board.name %>"
                class="pro-btn-danger-muted flex-1 px-3 py-1.5 text-xs"
              >
                Delete
              </button>
            </div>

            <form action="/admin/categories/delete" method="post" class="hidden" data-delete-category-form="<%= boardKey %>">
              <input type="hidden" name="categoryName" value="<%= board.name %>" />
              <input type="hidden" name="redirectTo" value="<%= adminProductsRedirectPath %>" />
            </form>
          </article>
          <% }) %>
        </div>
        <% } %>
      </section>

      <section class="pro-panel p-4 pro-stagger">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-xl font-extrabold tracking-tight text-slate-900">Product Overview</h2>
          <span class="ml-auto rounded-full border border-slate-300 bg-slate-50 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= productRows.length %> products</span>
        </div>

        <% if (!productRows.length) { %>
        <div class="mt-4 text-sm text-slate-500">No products found in current category boards.</div>
        <% } else { %>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[64rem] border-collapse">
            <thead>
              <tr class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-600">
                <th class="rounded-l-md border border-slate-200 px-3 py-2">Product</th>
                <th class="border border-slate-200 px-3 py-2">Category</th>
                <th class="border border-slate-200 px-3 py-2">Price</th>
                <th class="border border-slate-200 px-3 py-2">Spec</th>
                <th class="rounded-r-md border border-slate-200 px-3 py-2">Actions</th>
              </tr>
            </thead>
            <tbody class="text-sm text-slate-700">
              <% overviewRows.forEach(function (row) { %>
              <tr class="transition-colors hover:bg-slate-50">
                <td class="border border-slate-200 px-3 py-2">
                  <div class="flex items-center gap-2">
                    <img
                      src="<%= row.image || '/images/productParts/no-image.webp' %>"
                      alt="<%= row.name %>"
                      onerror="this.onerror=null;this.src='/images/productParts/no-image.webp';"
                      class="h-10 w-10 rounded-md border border-slate-200 bg-white object-cover"
                      loading="lazy"
                    />
                    <span class="font-semibold text-slate-800"><%= row.name || 'Untitled Product' %></span>
                  </div>
                </td>
                <td class="border border-slate-200 px-3 py-2 font-medium"><%= row.categoryName || 'Other' %></td>
                <td class="border border-slate-200 px-3 py-2"><%= row.price || 'Contact for price' %></td>
                <td class="border border-slate-200 px-3 py-2"><%= row.spec || 'N/A' %></td>
                <td class="border border-slate-200 px-3 py-2">
                  <div class="flex flex-wrap items-center gap-2">
                    <a
                      href="/admin/categories/<%= toAnchor(row.categoryName) %>"
                      class="pro-btn-secondary px-2.5 py-1 text-xs"
                    >
                      Open
                    </a>
                    <button
                      type="button"
                      data-delete-product-trigger="<%= row.id %>"
                      data-product-name="<%= row.name %>"
                      class="pro-btn-danger-muted px-2.5 py-1 text-xs"
                    >
                      Delete
                    </button>
                  </div>
                  <form action="/admin/products/delete" method="post" class="hidden" data-delete-product-form="<%= row.id %>">
                    <input type="hidden" name="productId" value="<%= row.id %>" />
                    <input type="hidden" name="redirectTo" value="<%= adminProductsRedirectPath %>" />
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <% if (overviewTotalPages > 1) { %>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
          <a
            href="<%= buildAdminProductsPageHref(overviewCurrentPage - 1) %>"
            class="pro-btn-secondary px-3 py-1.5 text-xs <%= overviewCurrentPage <= 1 ? 'pointer-events-none opacity-50' : '' %>"
            aria-disabled="<%= overviewCurrentPage <= 1 ? 'true' : 'false' %>"
          >
            Prev
          </a>

          <div class="flex flex-wrap items-center justify-center gap-1.5">
            <% for (var overviewPageNumber = 1; overviewPageNumber <= overviewTotalPages; overviewPageNumber += 1) { %>
            <% if (overviewPageNumber === 1 || overviewPageNumber === overviewTotalPages || Math.abs(overviewPageNumber - overviewCurrentPage) <= 1) { %>
            <a
              href="<%= buildAdminProductsPageHref(overviewPageNumber) %>"
              class="inline-flex min-w-[2.15rem] items-center justify-center rounded-lg border px-2.5 py-1.5 text-xs font-semibold transition <%= overviewPageNumber === overviewCurrentPage ? 'border-cyan-600 bg-cyan-600 text-white' : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-100' %>"
            >
              <%= overviewPageNumber %>
            </a>
            <% } else if ((overviewPageNumber === 2 && overviewCurrentPage > 4) || (overviewPageNumber === overviewTotalPages - 1 && overviewCurrentPage < overviewTotalPages - 3)) { %>
            <span class="px-1 text-xs font-semibold text-slate-500">…</span>
            <% } %>
            <% } %>
          </div>

          <a
            href="<%= buildAdminProductsPageHref(overviewCurrentPage + 1) %>"
            class="pro-btn-secondary px-3 py-1.5 text-xs <%= overviewCurrentPage >= overviewTotalPages ? 'pointer-events-none opacity-50' : '' %>"
            aria-disabled="<%= overviewCurrentPage >= overviewTotalPages ? 'true' : 'false' %>"
          >
            Next
          </a>
        </div>
        <% } %>
        <% } %>
      </section>
    </main>

    <div id="delete-alert" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 p-4">
      <div class="pro-panel w-full max-w-md p-5">
        <h3 class="text-lg font-bold text-slate-900" id="delete-alert-title">Delete</h3>
        <p class="mt-2 text-sm text-slate-700" id="delete-alert-message">Are you sure you want to delete this category?</p>
        <div class="mt-4 flex items-center justify-end gap-2">
          <button
            type="button"
            id="delete-alert-cancel"
            class="pro-btn-secondary"
          >
            Cancel
          </button>
          <button
            type="button"
            id="delete-alert-confirm"
            class="pro-btn-danger"
          >
            Delete
          </button>
        </div>
      </div>
    </div>

    <script id="admin-page-data" type="application/json"><%- JSON.stringify({ subcategoryOptionsByCategory: subcategoryOptionsByCategory }).replace(/</g, '\\u003c') %></script>
    <script src="/javascripts/flash-alert.js"></script>
    <script src="/javascripts/admin.js"></script>
  </body>
</html>
