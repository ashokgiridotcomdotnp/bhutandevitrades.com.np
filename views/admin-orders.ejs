<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="text-slate-900">
    <main class="app-shell py-6 pro-page-enter">
      <%
        function formatDateTime(value) {
          var parsedDate = value ? new Date(value) : null;

          if (!parsedDate || Number.isNaN(parsedDate.getTime())) {
            return '-';
          }

          return parsedDate.toLocaleString('en-NP', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });
        }

        var orderRequests = Array.isArray(adminOrderRequests)
          ? adminOrderRequests.filter(function (item) {
              return item && item._id;
            })
          : [];
        var orderRequestsError = String(adminOrderRequestsError || '').trim();
        var pendingOrdersCount = Number.isFinite(Number(pendingOrderRequestsCount))
          ? Number(pendingOrderRequestsCount)
          : 0;
        var acceptedOrdersCount = Number.isFinite(Number(acceptedOrderRequestsCount))
          ? Number(acceptedOrderRequestsCount)
          : 0;
        var ordersPagePath = '/admin/orders';
        var pendingOrderRows = orderRequests.filter(function (item) {
          return String(item && item.adminStatus ? item.adminStatus : '').toLowerCase() !== 'accepted';
        });
        var acceptedOrderRows = orderRequests.filter(function (item) {
          return String(item && item.adminStatus ? item.adminStatus : '').toLowerCase() === 'accepted';
        });
      %>

      <header class="mb-4 pro-panel px-5 py-4 pro-stagger">
        <div class="flex flex-wrap items-start gap-3">
          <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Order Requests</h1>
            <p class="mt-0.5 text-sm text-slate-600">Manage incoming requests and communicate clearly with customers.</p>
          </div>

          <div class="ml-auto flex flex-wrap items-center gap-2">
            <a href="/admin" class="pro-btn-secondary px-3 py-1.5 text-sm">Dashboard</a>
            <a href="/" class="pro-btn-secondary px-3 py-1.5 text-sm">Storefront</a>
            <form action="/admin/logout" method="post">
              <button type="submit" class="pro-btn-secondary gap-1.5 px-3 py-1.5 text-sm">
                <img src="/icons/logout.svg" alt="" aria-hidden="true" class="shrink-0" style="width: 14px; height: 14px;" />
                <span>Logout</span>
              </button>
            </form>
          </div>
        </div>
      </header>

      <% if (statusMessage) { %>
      <div
        data-success-alert
        role="status"
        class="mb-3 rounded-xl border border-emerald-300 bg-emerald-50/95 px-4 py-2.5 text-sm font-semibold text-emerald-700 shadow-lg backdrop-blur"
      >
        <%= statusMessage %>
      </div>
      <% } %>

      <% if (errorMessage) { %>
      <div class="mb-3 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" data-error-alert>
        <%= errorMessage %>
      </div>
      <% } %>

      <section class="mb-4 grid gap-3 sm:grid-cols-3">
        <article class="pro-panel p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Total Requests</p>
          <p class="mt-1 text-2xl font-extrabold tracking-tight text-slate-900"><%= orderRequests.length %></p>
          <p class="mt-1 text-xs text-slate-500">All incoming and processed</p>
        </article>
        <article class="pro-panel p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">Pending</p>
          <p class="mt-1 text-2xl font-extrabold tracking-tight text-amber-700"><%= pendingOrdersCount %></p>
          <p class="mt-1 text-xs text-slate-500">Needs admin action</p>
        </article>
        <article class="pro-panel p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Accepted</p>
          <p class="mt-1 text-2xl font-extrabold tracking-tight text-emerald-700"><%= acceptedOrdersCount %></p>
          <p class="mt-1 text-xs text-slate-500">Customer already notified</p>
        </article>
      </section>

      <% if (orderRequestsError) { %>
      <section class="pro-panel p-4">
        <div class="rounded-lg border border-red-300 bg-red-50 px-3 py-2 text-sm font-medium text-red-700"><%= orderRequestsError %></div>
      </section>
      <% } %>

      <% if (!orderRequestsError && !orderRequests.length) { %>
      <section class="pro-panel p-5 text-sm text-slate-600">
        No order requests found yet.
      </section>
      <% } %>

      <% if (!orderRequestsError && orderRequests.length) { %>
      <section class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
        <article class="pro-panel p-4">
          <div class="mb-3 flex items-center gap-2">
            <h2 class="text-lg font-extrabold tracking-tight text-slate-900">Pending Requests</h2>
            <span class="rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700"><%= pendingOrderRows.length %></span>
          </div>

          <% if (!pendingOrderRows.length) { %>
          <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600">No pending requests.</div>
          <% } %>

          <% if (pendingOrderRows.length) { %>
          <div class="space-y-3">
            <% pendingOrderRows.forEach(function (orderItem) { %>
            <%
              var orderId = String(orderItem && orderItem._id ? orderItem._id : '');
              var productName = String(orderItem && orderItem.productName ? orderItem.productName : 'Product');
              var productType = String(orderItem && orderItem.productType ? orderItem.productType : 'Category');
              var quantity = Number(orderItem && orderItem.quantity);
              var safeQuantity = Number.isFinite(quantity) && quantity > 0 ? Math.floor(quantity) : 1;
              var totalLabel = String(orderItem && orderItem.totalLabel ? orderItem.totalLabel : 'Contact for price');
              var customerName = String(orderItem && orderItem.customerName ? orderItem.customerName : '-');
              var customerEmail = String(orderItem && orderItem.customerEmail ? orderItem.customerEmail : '-');
              var phoneNumber = String(orderItem && orderItem.phoneNumber ? orderItem.phoneNumber : '-');
              var note = String(orderItem && orderItem.note ? orderItem.note : '-');
              var createdAtLabel = formatDateTime(orderItem && orderItem.createdAt);
            %>
            <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <h3 class="text-lg font-extrabold tracking-tight text-slate-900"><%= productName %></h3>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= productType %></p>
                </div>
                <span class="inline-flex items-center rounded-full border border-amber-300 bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700">Pending</span>
              </div>

              <dl class="mt-3 grid gap-x-3 gap-y-1.5 text-sm sm:grid-cols-2">
                <div><dt class="font-semibold text-slate-900">Quantity</dt><dd class="text-slate-700"><%= safeQuantity %></dd></div>
                <div><dt class="font-semibold text-slate-900">Total</dt><dd class="text-slate-700"><%= totalLabel %></dd></div>
                <div><dt class="font-semibold text-slate-900">Customer</dt><dd class="text-slate-700"><%= customerName %></dd></div>
                <div><dt class="font-semibold text-slate-900">Email</dt><dd class="break-all text-slate-700"><%= customerEmail %></dd></div>
                <div><dt class="font-semibold text-slate-900">Phone</dt><dd class="text-slate-700"><%= phoneNumber %></dd></div>
                <div><dt class="font-semibold text-slate-900">Requested At</dt><dd class="text-slate-700"><%= createdAtLabel %></dd></div>
              </dl>

              <div class="mt-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
                <span class="font-semibold text-slate-900">Customer Note:</span> <%= note %>
              </div>

              <form action="/admin/orders/accept" method="post" class="mt-4 border-t border-slate-200 pt-4">
                <input type="hidden" name="orderId" value="<%= orderId %>" />
                <input type="hidden" name="redirectTo" value="<%= ordersPagePath %>" />
                <div class="space-y-1.5">
                  <label class="block text-sm font-semibold text-slate-800" for="admin-order-message-<%= orderId %>">Admin message (optional)</label>
                  <textarea
                    id="admin-order-message-<%= orderId %>"
                    name="adminMessage"
                    rows="2"
                    maxlength="1000"
                    placeholder="Message to customer"
                    class="pro-input"
                  ></textarea>
                </div>
                <div class="mt-3 flex items-center justify-end">
                  <button type="submit" class="pro-btn-primary px-3 py-1.5 text-xs">Accept and Send Message</button>
                </div>
              </form>
            </article>
            <% }) %>
          </div>
          <% } %>
        </article>

        <article class="pro-panel p-4">
          <div class="mb-3 flex items-center gap-2">
            <h2 class="text-lg font-extrabold tracking-tight text-slate-900">Accepted Requests</h2>
            <span class="rounded-full border border-emerald-300 bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700"><%= acceptedOrderRows.length %></span>
          </div>

          <% if (!acceptedOrderRows.length) { %>
          <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600">No accepted requests yet.</div>
          <% } %>

          <% if (acceptedOrderRows.length) { %>
          <div class="space-y-3">
            <% acceptedOrderRows.forEach(function (orderItem) { %>
            <%
              var productNameAccepted = String(orderItem && orderItem.productName ? orderItem.productName : 'Product');
              var productTypeAccepted = String(orderItem && orderItem.productType ? orderItem.productType : 'Category');
              var quantityAccepted = Number(orderItem && orderItem.quantity);
              var safeQuantityAccepted = Number.isFinite(quantityAccepted) && quantityAccepted > 0 ? Math.floor(quantityAccepted) : 1;
              var totalLabelAccepted = String(orderItem && orderItem.totalLabel ? orderItem.totalLabel : 'Contact for price');
              var customerNameAccepted = String(orderItem && orderItem.customerName ? orderItem.customerName : '-');
              var customerEmailAccepted = String(orderItem && orderItem.customerEmail ? orderItem.customerEmail : '-');
              var phoneNumberAccepted = String(orderItem && orderItem.phoneNumber ? orderItem.phoneNumber : '-');
              var noteAccepted = String(orderItem && orderItem.note ? orderItem.note : '-');
              var createdAtLabelAccepted = formatDateTime(orderItem && orderItem.createdAt);
              var adminMessageAccepted = String(orderItem && orderItem.adminMessage ? orderItem.adminMessage : '');
              var acceptedAtLabel = formatDateTime(orderItem && orderItem.adminAcceptedAt);
              var isAdminEmailSent = Boolean(orderItem && orderItem.adminEmailNotificationSent);
            %>
            <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <h3 class="text-lg font-extrabold tracking-tight text-slate-900"><%= productNameAccepted %></h3>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= productTypeAccepted %></p>
                </div>
                <span class="inline-flex items-center rounded-full border border-emerald-300 bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700">Accepted</span>
              </div>

              <dl class="mt-3 grid gap-x-3 gap-y-1.5 text-sm sm:grid-cols-2">
                <div><dt class="font-semibold text-slate-900">Quantity</dt><dd class="text-slate-700"><%= safeQuantityAccepted %></dd></div>
                <div><dt class="font-semibold text-slate-900">Total</dt><dd class="text-slate-700"><%= totalLabelAccepted %></dd></div>
                <div><dt class="font-semibold text-slate-900">Customer</dt><dd class="text-slate-700"><%= customerNameAccepted %></dd></div>
                <div><dt class="font-semibold text-slate-900">Email</dt><dd class="break-all text-slate-700"><%= customerEmailAccepted %></dd></div>
                <div><dt class="font-semibold text-slate-900">Phone</dt><dd class="text-slate-700"><%= phoneNumberAccepted %></dd></div>
                <div><dt class="font-semibold text-slate-900">Requested At</dt><dd class="text-slate-700"><%= createdAtLabelAccepted %></dd></div>
              </dl>

              <div class="mt-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
                <span class="font-semibold text-slate-900">Customer Note:</span> <%= noteAccepted %>
              </div>

              <% if (adminMessageAccepted) { %>
              <div class="mt-2 rounded-lg border border-cyan-200 bg-cyan-50 px-3 py-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-cyan-800">Admin Message</p>
                <p class="mt-1 text-sm font-medium text-cyan-900"><%= adminMessageAccepted %></p>
              </div>
              <% } %>

              <div class="mt-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-800">
                <p><span class="font-semibold">Accepted At:</span> <%= acceptedAtLabel %></p>
                <p>
                  <span class="font-semibold">Email Notification:</span>
                  <span class="<%= isAdminEmailSent ? 'text-emerald-700' : 'text-amber-700' %>"><%= isAdminEmailSent ? 'Sent' : 'Not Sent' %></span>
                </p>
              </div>
            </article>
            <% }) %>
          </div>
          <% } %>
        </article>
      </section>
      <% } %>
    </main>

    <script src="/javascripts/admin-orders.js"></script>
    <script src="/javascripts/flash-alert.js"></script>
  </body>
</html>
