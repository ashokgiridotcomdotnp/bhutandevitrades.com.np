<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="bg-slate-100 text-slate-900" style="font-family: 'Manrope', sans-serif">
    <%- include('helpers/nav', { title: 'BhutanDevi Trade and Suppliers', q, activeCategory, hasSidebar: false, topNavCategories, searchSuggestions, basePath }) %>

    <main class="mx-auto max-w-5xl px-4 py-6 sm:px-6 lg:px-8">
      <a href="/" class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 hover:bg-slate-100">
        Back to products
      </a>

      <section class="mt-4 rounded-2xl border border-slate-300 bg-white p-6 shadow-sm">
        <div class="grid gap-6 lg:grid-cols-[1fr_1.2fr]">
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <img
              src="<%= product.image %>"
              alt="<%= product.name %>"
              onerror="this.onerror=null;this.src='/images/productParts/no-image.webp';"
              class="mx-auto h-80 w-full max-w-md object-contain"
            />
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-600"><%= product.type %></p>
            <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900"><%= product.name %></h1>
            <p class="mt-2 text-sm text-slate-600"><%= product.spec %></p>
            <div class="mt-4 inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">Section: <%= sectionTitle %></div>
            <p class="mt-6 text-2xl font-extrabold text-slate-900"><%= product.price %></p>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
