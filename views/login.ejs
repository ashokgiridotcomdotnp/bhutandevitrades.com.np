<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="text-slate-900">
    <%- include('helpers/nav', { title: 'BhutanDevi Trade and Suppliers', q, activeCategory, hasSidebar: true, topNavCategories, searchSuggestions, basePath, currentPath, currentUser, showUserAuthActions }) %>

    <main class="app-shell py-6">
      <div id="home-layout-grid" class="grid gap-5 lg:grid-cols-[20rem_minmax(0,1fr)]">
        <%- include('helpers/sidebar', { categoryGroups, hasQuery, q, activeCategory, openCategoryName, basePath, currentUser, showUserAuthActions, currentPath }) %>

        <section class="min-w-0 pro-page-enter">
          <section class="mx-auto w-full max-w-4xl pro-panel p-4 sm:p-6">
            <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_17rem]">
              <div class="pro-stagger">
                <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Login</h1>
                <p class="mt-1 text-sm text-slate-600">Use your email and password to sign in.</p>

                <% if (statusMessage) { %>
                <div class="mt-4 flex items-start justify-between gap-3 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700" data-success-alert>
                  <span><%= statusMessage %></span>
                  <button
                    type="button"
                    class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-emerald-300 bg-white/80 text-emerald-700 hover:bg-white"
                    data-dismiss-alert
                    aria-label="Dismiss success message"
                  >
                    &times;
                  </button>
                </div>
                <% } %>

                <% if (errorMessage) { %>
                <div class="mt-4 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-700" data-error-alert><%= errorMessage %></div>
                <% } %>

                <form action="/login" method="post" class="mt-5 space-y-4">
                  <div>
                    <label for="login-email" class="mb-1.5 block text-sm font-semibold text-slate-800">Email Address</label>
                    <input
                      id="login-email"
                      name="email"
                      type="email"
                      value="<%= authEmail || '' %>"
                      maxlength="<%= maxEmailLength %>"
                      autocomplete="email"
                      required
                      class="pro-input"
                      placeholder="you@gmail.com"
                    />
                  </div>

                  <div>
                    <label for="login-password" class="mb-1.5 block text-sm font-semibold text-slate-800">Password</label>
                    <input
                      id="login-password"
                      name="password"
                      type="password"
                      autocomplete="current-password"
                      minlength="<%= minPasswordLength %>"
                      maxlength="<%= maxPasswordLength %>"
                      required
                      class="pro-input <%= errorMessage ? 'border-red-300 focus:border-red-300' : '' %>"
                      aria-invalid="<%= errorMessage ? 'true' : 'false' %>"
                      <%= errorMessage ? 'aria-describedby=\"login-inline-error\"' : '' %>
                      placeholder="Enter your password"
                    />
                    <% if (errorMessage) { %>
                    <p id="login-inline-error" class="mt-1.5 text-sm font-semibold text-red-700"><%= errorMessage %></p>
                    <% } %>
                  </div>

                  <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
                    <div class="flex flex-wrap items-center gap-3">
                      <a href="/signup" class="text-sm font-semibold text-cyan-700 hover:text-cyan-800">Create an account</a>
                      <a href="/forgot-password" class="text-sm font-semibold text-slate-600 hover:text-slate-800">Forgot password?</a>
                    </div>
                    <button type="submit" class="pro-btn-primary">Login</button>
                  </div>
                </form>
              </div>

              <aside class="hidden rounded-xl border border-slate-200 bg-slate-50 p-4 lg:block">
                <h2 class="text-xs font-extrabold uppercase tracking-[0.14em] text-slate-500">Account Benefits</h2>
                <ul class="mt-3 space-y-2 text-sm font-medium text-slate-700">
                  <li>Track order requests from one place.</li>
                  <li>Save profile details for faster checkout.</li>
                  <li>Use secure password recovery anytime.</li>
                </ul>
                <div class="mt-4 rounded-lg border border-cyan-200 bg-cyan-50 p-3 text-xs font-semibold text-cyan-800">
                  New here? Create an account in under a minute.
                </div>
              </aside>
            </div>
          </section>
        </section>
      </div>
    </main>
    <%- include('helpers/footer', { basePath, currentPath, categoryGroups, currentUser }) %>
    <script src="/javascripts/flash-alert.js"></script>
  </body>
</html>
