<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 text-slate-900">
    <div class="flex min-h-screen flex-col items-center justify-center px-4 py-12">
      <a href="/" class="mb-8 inline-flex items-center gap-2 rounded-xl bg-slate-900 px-4 py-2.5 text-white shadow-sm">
        <img src="/icons/logo.svg" alt="" class="h-8 w-8 rounded-full bg-white p-1" />
        <span class="text-sm font-bold tracking-wide">Back To Home Page</span>
      </a>

      <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-lg sm:p-8">
        <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">Welcome back</h1>
        <p class="mt-1 text-sm text-slate-600">Sign in to your account</p>

        <% if (statusMessage) { %>
        <div class="mt-4 rounded-lg border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">
          <%= statusMessage %>
        </div>
        <% } %>

        <% if (errorMessage) { %>
        <div class="mt-4 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
          <%= errorMessage %>
        </div>
        <% } %>

        <form action="/login" method="post" class="mt-6 space-y-4">
          <div>
            <label for="login-email" class="mb-1.5 block text-sm font-semibold text-slate-800">Email</label>
            <input
              id="login-email"
              name="email"
              type="email"
              value="<%= authEmail || '' %>"
              maxlength="<%= maxEmailLength %>"
              autocomplete="email"
              required
              class="pro-input"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label for="login-password" class="mb-1.5 block text-sm font-semibold text-slate-800">Password</label>
            <input
              id="login-password"
              name="password"
              type="password"
              autocomplete="current-password"
              minlength="<%= minPasswordLength %>"
              maxlength="<%= maxPasswordLength %>"
              required
              class="pro-input <%= errorMessage ? 'border-red-300 focus:border-red-300' : '' %>"
              placeholder="Enter your password"
            />
          </div>

          <button type="submit" class="pro-btn-primary w-full">Sign In</button>
        </form>

        <div class="mt-6 flex items-center justify-between text-sm">
          <a href="/signup" class="font-semibold text-cyan-700 hover:text-cyan-800">Create account</a>
          <a href="/forgot-password" class="font-semibold text-slate-600 hover:text-slate-800">Forgot password?</a>
        </div>
      </div>

      <p class="mt-8 text-center text-xs text-slate-500">
        Secure login powered by bhutandevitradeandsuppliers
      </p>
    </div>
  </body>
</html>
