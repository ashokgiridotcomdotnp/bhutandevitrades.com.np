<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <title>Error</title>
    <link rel="stylesheet" href="<%= assetPath('/stylesheets/style.css') %>" />
  </head>
  <body class="text-slate-900">
    <main class="app-shell flex min-h-screen items-center py-8 pro-page-enter">
      <section class="pro-panel mx-auto w-full max-w-2xl p-6 sm:p-8 pro-stagger">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan-700">Request Failed</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900"><%= message %></h1>
        <p class="mt-2 text-sm font-medium text-slate-500">Status code: <%= statusCode || 500 %></p>

        <% if (error && error.stack) { %>
        <pre class="mt-5 overflow-x-auto rounded-xl border border-slate-200 bg-slate-900 p-4 text-xs leading-relaxed text-slate-100"><%= error.stack %></pre>
        <% } %>
      </section>
    </main>
  </body>
</html>
