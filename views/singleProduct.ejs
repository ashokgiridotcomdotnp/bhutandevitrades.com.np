<%
  var sectionBasedCatalog = [];

  if (Array.isArray(productSections)) {
    productSections.forEach(function(section) {
      if (!Array.isArray(section.items)) {
        return;
      }

        section.items.forEach(function(item) {
          sectionBasedCatalog.push({
            title: item.name || 'N/A',
            description: item.spec || 'N/A',
            mrp: item.price || 'Contact for price',
            image: item.image || '/images/productParts/no-image.webp'
          });
        });
      });
  }

  var visibleCatalog = sectionBasedCatalog;
%>

<section id="products" class="space-y-10">
  <% if (showCarousel && Array.isArray(carouselImages) && carouselImages.length > 0) { %>
  <section data-home-carousel class="relative overflow-hidden rounded-2xl border border-slate-300 bg-white shadow-sm">
    <div data-carousel-track class="flex transition duration-500 ease-out">
      <% carouselImages.forEach(function(image, index) { %>
      <div class="w-full shrink-0">
        <img
          src="<%= image %>"
          alt="BhutanDevi banner <%= index + 1 %>"
          class="h-56 w-full object-cover sm:h-64 md:h-72"
        />
      </div>
      <% }) %>
    </div>

    <% if (carouselImages.length > 1) { %>
    <button
      type="button"
      data-carousel-prev
      aria-label="Previous slide"
      class="absolute left-3 top-1/2 inline-flex -translate-y-1/2 items-center justify-center rounded-full bg-white/90 px-2.5 py-2 text-slate-700 shadow-sm hover:bg-white"
    >
      &#10094;
    </button>
    <button
      type="button"
      data-carousel-next
      aria-label="Next slide"
      class="absolute right-3 top-1/2 inline-flex -translate-y-1/2 items-center justify-center rounded-full bg-white/90 px-2.5 py-2 text-slate-700 shadow-sm hover:bg-white"
    >
      &#10095;
    </button>
    <div class="absolute bottom-3 left-1/2 flex -translate-x-1/2 items-center gap-2">
      <% carouselImages.forEach(function(_, index) { %>
      <button
        type="button"
        data-carousel-dot
        data-carousel-index="<%= index %>"
        aria-label="Go to slide <%= index + 1 %>"
        class="h-2.5 w-2.5 rounded-full bg-white/70 transition hover:bg-white"
      ></button>
      <% }) %>
    </div>
    <% } %>
  </section>
  <% } %>

  <% if (visibleCatalog.length === 0) { %>
  <div class="rounded-2xl border border-slate-300 bg-white p-6 text-center text-sm font-medium text-slate-600">
    No products available for your current filter.
  </div>
  <% } %>

  <% for (var rowIndex = 0; rowIndex < visibleCatalog.length; rowIndex += 3) { %>
  <div class="grid gap-4 md:grid-cols-3 md:gap-0">
    <% visibleCatalog.slice(rowIndex, rowIndex + 3).forEach(function(item) { %>
    <table class="w-full border border-slate-700 bg-white text-slate-900">
      <tr>
        <td colspan="2" class="h-72 border-b border-slate-700 p-3">
          <div class="flex h-full items-center justify-center bg-white">
            <img src="<%= item.image %>" alt="<%= item.title %>" onerror="this.onerror=null;this.src='/images/productParts/no-image.webp';" class="h-full max-h-full object-contain" />
          </div>
        </td>
      </tr>
      <tr>
        <th class="w-1/3 border-r border-b border-slate-700 px-2 py-2 text-left text-lg font-bold">Title:</th>
        <td class="border-b border-slate-700 px-2 py-2 text-lg"><%= item.title %></td>
      </tr>
      <tr>
        <th class="border-r border-b border-slate-700 px-2 py-2 text-left text-lg font-bold">Description:</th>
        <td class="border-b border-slate-700 px-2 py-2 text-lg"><%= item.description %></td>
      </tr>
      <tr>
        <th class="border-r border-slate-700 px-2 py-2 text-left text-lg font-bold">MRP:</th>
        <td class="px-2 py-2 text-lg"><%= item.mrp %></td>
      </tr>
    </table>
    <% }) %>
  </div>
  <% } %>
</section>
